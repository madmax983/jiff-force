/**
 * Replays civil date vectors generated by the real Jiff crate (see `oracle/`) against the
 * port. `ERR` in a vector means Jiff reported an error; `JiffOracleSupport` describes how
 * the other values are written.
 */
@IsTest
private class JiffOracleDateTest {
    private static final List<JiffWeekday> WEEKDAYS = JiffWeekday.values();

    @IsTest
    static void datesAgreeWithJiff() {
        List<String> rows = JiffOracleDateData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = row.split('\\|');
            Integer year = Integer.valueOf(f.get(0));
            Integer month = Integer.valueOf(f.get(1));
            Integer day = Integer.valueOf(f.get(2));
            Long epochDay = Long.valueOf(f.get(3));
            JiffDate d = JiffDate.newInstance(year, month, day);
            Assert.areEqual(epochDay, d.toEpochDay(), 'epoch day of ' + row);
            Assert.areEqual(d, JiffDate.fromEpochDay(epochDay), 'date from epoch day of ' + row);
            Assert.areEqual(
                WEEKDAYS.get(Integer.valueOf(f.get(4))),
                d.weekday(),
                'weekday of ' + row
            );
            Assert.areEqual(Integer.valueOf(f.get(5)), d.dayOfYear(), 'day of year of ' + row);
            Assert.areEqual(f.get(6).equals('1'), JiffDate.isLeapYear(year), 'leap year of ' + row);
            Assert.areEqual(
                Integer.valueOf(f.get(7)),
                JiffDate.daysInMonth(year, month),
                'month length of ' + row
            );
            Assert.areEqual(f.get(8), d.toString(), 'text of ' + row);
        }
    }

    /** One of the four ways of adding a span, as text, with `ERR` for a thrown exception. */
    private static String withSpan(String op, JiffDate d, JiffSpan span) {
        try {
            if (op.equals('add')) {
                return d.add(span).toString();
            } else if (op.equals('subtract')) {
                return d.subtract(span).toString();
            } else if (op.equals('saturatingAdd')) {
                return d.saturatingAdd(span).toString();
            }
            return d.saturatingSubtract(span).toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    /** One of the four ways of adding a duration, as text, with `ERR` for a thrown exception. */
    private static String withDuration(String op, JiffDate d, JiffSignedDuration duration) {
        try {
            if (op.equals('add')) {
                return d.add(duration).toString();
            } else if (op.equals('subtract')) {
                return d.subtract(duration).toString();
            } else if (op.equals('saturatingAdd')) {
                return d.saturatingAdd(duration).toString();
            }
            return d.saturatingSubtract(duration).toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void addingSpansAgreesWithJiff() {
        List<String> rows = JiffOracleDateSpanData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDate d = JiffOracleSupport.toDate(f.get(0));
            JiffSpan span = JiffOracleSupport.toSpan(f.get(1));
            Assert.areEqual(f.get(2), withSpan('add', d, span), 'sum of ' + row);
            Assert.areEqual(f.get(3), withSpan('subtract', d, span), 'difference of ' + row);
            Assert.areEqual(
                f.get(4),
                withSpan('saturatingAdd', d, span),
                'saturating sum of ' + row
            );
            Assert.areEqual(
                f.get(5),
                withSpan('saturatingSubtract', d, span),
                'saturating difference of ' + row
            );
        }
    }

    @IsTest
    static void addingDurationsAgreesWithJiff() {
        List<String> rows = JiffOracleDateDurationData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDate d = JiffOracleSupport.toDate(f.get(0));
            JiffSignedDuration duration = JiffOracleSupport.toDuration(f.get(1));
            Assert.areEqual(f.get(2), withDuration('add', d, duration), 'sum of ' + row);
            Assert.areEqual(
                f.get(3),
                withDuration('subtract', d, duration),
                'difference of ' + row
            );
            Assert.areEqual(
                f.get(4),
                withDuration('saturatingAdd', d, duration),
                'saturating sum of ' + row
            );
            Assert.areEqual(
                f.get(5),
                withDuration('saturatingSubtract', d, duration),
                'saturating difference of ' + row
            );
        }
    }

    /** `a.until(b)` or `a.since(b)` with a largest unit, with `ERR` for a thrown exception. */
    private static String difference(Boolean until, JiffDate a, JiffDate b, JiffUnit largest) {
        try {
            return JiffOracleSupport.spanText(until ? a.until(b, largest) : a.since(b, largest));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void differencesAgreeWithJiff() {
        List<JiffUnit> largest = new List<JiffUnit>{
            JiffUnit.DAY,
            JiffUnit.WEEK,
            JiffUnit.MONTH,
            JiffUnit.YEAR
        };
        List<String> rows = JiffOracleDateDifferenceData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDate a = JiffOracleSupport.toDate(f.get(0));
            JiffDate b = JiffOracleSupport.toDate(f.get(1));
            for (Integer i = 0; i < largest.size(); i++) {
                JiffUnit unit = largest.get(i);
                Assert.areEqual(
                    f.get(2 + i),
                    difference(true, a, b, unit),
                    'until in ' + unit + ' of ' + row
                );
                Assert.areEqual(
                    f.get(6 + i),
                    difference(false, a, b, unit),
                    'since in ' + unit + ' of ' + row
                );
            }
            // With no unit given, the largest unit is days.
            Assert.areEqual(f.get(2), JiffOracleSupport.spanText(a.until(b)), 'until of ' + row);
            Assert.areEqual(f.get(6), JiffOracleSupport.spanText(a.since(b)), 'since of ' + row);
            Assert.areEqual(
                f.get(10),
                JiffOracleSupport.durationText(a.durationUntil(b)),
                'duration until of ' + row
            );
            Assert.areEqual(
                f.get(10),
                JiffOracleSupport.durationText(b.durationSince(a)),
                'duration since of ' + row
            );
            Assert.areEqual(
                f.get(11),
                difference(true, a, b, JiffUnit.HOUR),
                'until in hours of ' + row
            );
        }
    }

    /** Tomorrow or yesterday as text, with `ERR` for a thrown exception. */
    private static String neighbour(Boolean next, JiffDate d) {
        try {
            return (next ? d.tomorrow() : d.yesterday()).toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void calendarQueriesAgreeWithJiff() {
        List<String> rows = JiffOracleDateCalendarData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDate d = JiffOracleSupport.toDate(f.get(0));
            Assert.areEqual(Integer.valueOf(f.get(1)), d.dayOfYear(), 'day of year of ' + row);
            Integer noLeap = d.dayOfYearNoLeap();
            Assert.areEqual(
                f.get(2),
                noLeap == null ? 'NONE' : String.valueOf(noLeap),
                'day of year without leap days of ' + row
            );
            Assert.areEqual(f.get(3), d.firstOfMonth().toString(), 'first of month of ' + row);
            Assert.areEqual(f.get(4), d.lastOfMonth().toString(), 'last of month of ' + row);
            Assert.areEqual(f.get(5), d.firstOfYear().toString(), 'first of year of ' + row);
            Assert.areEqual(f.get(6), d.lastOfYear().toString(), 'last of year of ' + row);
            Assert.areEqual(f.get(7), neighbour(true, d), 'tomorrow of ' + row);
            Assert.areEqual(f.get(8), neighbour(false, d), 'yesterday of ' + row);
            JiffIsoWeekDate weekDate = d.toIsoWeekDate();
            Assert.areEqual(
                f.get(9),
                JiffOracleSupport.weekDateText(weekDate),
                'ISO week date of ' + row
            );
            Assert.areEqual(weekDate, JiffIsoWeekDate.fromDate(d), 'ISO week date of ' + row);
            Assert.areEqual(d, weekDate.toDate(), 'date of the ISO week date of ' + row);
            Assert.areEqual(d, JiffDate.fromIsoWeekDate(weekDate), 'round trip of ' + row);
            Assert.areEqual(Integer.valueOf(f.get(10)), d.daysInYear(), 'days in year of ' + row);
            Assert.areEqual(f.get(11), d.eraYear() + ',' + d.era().name(), 'era year of ' + row);
        }
    }

    /** The nth weekday from a date, or within its month, with `ERR` for a thrown exception. */
    private static String nthWeekday(Boolean ofMonth, JiffDate d, Integer nth, JiffWeekday day) {
        try {
            return (ofMonth ? d.nthWeekdayOfMonth(nth, day) : d.nthWeekday(nth, day)).toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void nthWeekdaysAgreeWithJiff() {
        List<String> rows = JiffOracleDateWeekdayData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDate d = JiffOracleSupport.toDate(f.get(0));
            JiffWeekday day = JiffOracleSupport.weekday(f.get(1));
            Assert.areEqual(
                f.get(3),
                nthWeekday(false, d, Integer.valueOf(f.get(2)), day),
                'nth weekday of ' + row
            );
            Assert.areEqual(
                f.get(5),
                nthWeekday(true, d, Integer.valueOf(f.get(4)), day),
                'nth weekday of the month of ' + row
            );
        }
    }

    /** A neighbouring ISO week date by name, with `ERR` for a thrown exception. */
    private static String weekDateQuery(String query, JiffIsoWeekDate weekDate) {
        try {
            if (query.equals('firstOfWeek')) {
                return JiffOracleSupport.weekDateText(weekDate.firstOfWeek());
            } else if (query.equals('lastOfWeek')) {
                return JiffOracleSupport.weekDateText(weekDate.lastOfWeek());
            } else if (query.equals('firstOfYear')) {
                return JiffOracleSupport.weekDateText(weekDate.firstOfYear());
            } else if (query.equals('lastOfYear')) {
                return JiffOracleSupport.weekDateText(weekDate.lastOfYear());
            } else if (query.equals('tomorrow')) {
                return JiffOracleSupport.weekDateText(weekDate.tomorrow());
            }
            return JiffOracleSupport.weekDateText(weekDate.yesterday());
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void isoWeekDatesAgreeWithJiff() {
        List<String> queries = new List<String>{
            'firstOfWeek',
            'lastOfWeek',
            'firstOfYear',
            'lastOfYear',
            'tomorrow',
            'yesterday'
        };
        List<String> rows = JiffOracleIsoWeekDateData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffIsoWeekDate weekDate;
            try {
                weekDate = JiffIsoWeekDate.newInstance(
                    Integer.valueOf(f.get(0)),
                    Integer.valueOf(f.get(1)),
                    JiffOracleSupport.weekday(f.get(2))
                );
            } catch (JiffException e) {
                Assert.areEqual(JiffOracleSupport.ERR, f.get(3), 'rejected ' + row);
                continue;
            }
            Assert.areEqual(f.get(3), weekDate.toDate().toString(), 'date of ' + row);
            Assert.areEqual(
                weekDate,
                JiffOracleSupport.toDate(f.get(3)).toIsoWeekDate(),
                'week date of the date of ' + row
            );
            Assert.areEqual(
                Integer.valueOf(f.get(4)),
                weekDate.weeksInYear(),
                'weeks in year of ' + row
            );
            Assert.areEqual(f.get(4).equals('53'), weekDate.inLongYear(), 'long year of ' + row);
            Assert.areEqual(
                Integer.valueOf(f.get(5)),
                weekDate.daysInYear(),
                'days in year of ' + row
            );
            for (Integer i = 0; i < queries.size(); i++) {
                String query = queries.get(i);
                Assert.areEqual(f.get(6 + i), weekDateQuery(query, weekDate), query + ' of ' + row);
            }
        }
    }

    /** Applies setters written as `year=2023;eraYear=5:BCE;dayOfYear=60` and builds. */
    private static String build(JiffDate d, String setters) {
        JiffDateWith builder = d.with();
        if (!setters.equals('none')) {
            for (String setter : setters.split(';')) {
                List<String> parts = setter.split('=');
                String name = parts.get(0);
                String value = parts.get(1);
                if (name.equals('year')) {
                    builder = builder.year(Integer.valueOf(value));
                } else if (name.equals('eraYear')) {
                    List<String> yearAndEra = value.split(':');
                    builder = builder.eraYear(
                        Integer.valueOf(yearAndEra.get(0)),
                        yearAndEra.get(1).equals('CE') ? JiffEra.CE : JiffEra.BCE
                    );
                } else if (name.equals('month')) {
                    builder = builder.month(Integer.valueOf(value));
                } else if (name.equals('day')) {
                    builder = builder.day(Integer.valueOf(value));
                } else if (name.equals('dayOfYear')) {
                    builder = builder.dayOfYear(Integer.valueOf(value));
                } else {
                    Assert.areEqual('dayOfYearNoLeap', name, 'unknown setter in a vector');
                    builder = builder.dayOfYearNoLeap(Integer.valueOf(value));
                }
            }
        }
        try {
            return builder.build().toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void withBuilderAgreesWithJiff() {
        List<String> rows = JiffOracleDateWithData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDate d = JiffOracleSupport.toDate(f.get(0));
            Assert.areEqual(f.get(2), build(d, f.get(1)), 'building ' + row);
        }
    }
}
