/**
 * Replays date vectors generated by the real Jiff crate (see `oracle/`) against the port.
 */
@IsTest
private class JiffOracleDateTest {
    private static final List<JiffWeekday> WEEKDAYS = JiffWeekday.values();

    @IsTest
    static void datesAgreeWithJiff() {
        List<String> rows = JiffOracleDateData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = row.split('\\|');
            Integer year = Integer.valueOf(f.get(0));
            Integer month = Integer.valueOf(f.get(1));
            Integer day = Integer.valueOf(f.get(2));
            Long epochDay = Long.valueOf(f.get(3));
            JiffDate d = JiffDate.newInstance(year, month, day);
            Assert.areEqual(epochDay, d.toEpochDay(), 'epoch day of ' + row);
            Assert.areEqual(d, JiffDate.fromEpochDay(epochDay), 'date from epoch day of ' + row);
            Assert.areEqual(
                WEEKDAYS.get(Integer.valueOf(f.get(4))),
                d.weekday(),
                'weekday of ' + row
            );
            Assert.areEqual(f.get(6).equals('1'), JiffDate.isLeapYear(year), 'leap year of ' + row);
            Assert.areEqual(
                Integer.valueOf(f.get(7)),
                JiffDate.daysInMonth(year, month),
                'month length of ' + row
            );
            Assert.areEqual(f.get(8), d.toString(), 'text of ' + row);
        }
    }
}
