    @IsTest
    static void parsingAPrefixReportsHowMuchWasConsumed() {
        JiffBrokenDownTimePrefix prefix = JiffStrtimeParser.parsePrefix('%m/%d/%y', '7/14/2499');
        Assert.areEqual('2024-07-14', prefix.value().toDate().toString());
        Assert.areEqual(7, prefix.consumed());
        prefix = JiffStrtimeParser.parsePrefix('%Y-%m-%d', '2024-01-20T17:55Z');
        Assert.areEqual(10, prefix.consumed());
        Assert.areEqual('2024-01-20', prefix.value().toDate().toString());
    }

    @IsTest
    static void parsingAPrefixStillFailsOnInvalidInput() {
        try {
            JiffStrtimeParser.parsePrefix('%m/%d', '7-14');
            Assert.fail('expected the missing slash to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'strptime parsing failed: expected to match literal byte `/` from format string, but found byte `-` in input',
                e.getMessage()
            );
        }
    }

    @IsTest
    static void parsingNeedsInputAndAFormat() {
        try {
            JiffStrtimeParser.parse('%Y', null);
            Assert.fail('expected null input to be rejected');
        } catch (JiffException e) {
            Assert.isTrue(e.getMessage().contains('input'), e.getMessage());
        }
        try {
            JiffStrtimeParser.parse(null, '2024');
            Assert.fail('expected a null format to be rejected');
        } catch (JiffException e) {
            Assert.isTrue(e.getMessage().contains('format string'), e.getMessage());
        }
    }
