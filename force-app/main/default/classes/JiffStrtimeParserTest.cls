                new List<String>{ 'date', '%m/%d/%Y', '1/1/0099', '0099-01-01' },
                new List<String>{ 'date', '%m/%d/%Y', '1/1/1999', '1999-01-01' },
                new List<String>{ 'date', '%m/%d/%Y', '12/31/9999', '9999-12-31' },
