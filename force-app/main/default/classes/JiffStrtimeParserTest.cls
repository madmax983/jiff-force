/**
 * `strptime` parsing of every conversion specifier, and the assembly of dates, times,
 * datetimes, timestamps and zoned datetimes from what was parsed.
 *
 * Every row is `target, format, input, expected`. The target says what is made of the parse:
 * `tm` lists every field that was set (see `describe`), and `date`, `time`, `datetime`,
 * `timestamp` and `zoned` are the `toDate()`, `toTime()`, ... of the result. The expected
 * text, or `ERR:` and the error message, is what Jiff 1.0.0 itself produced for the same
 * format and input: the tables were generated by running the real crate
 * (`fmt::strtime::parse` and the `to_*` methods of `BrokenDownTime`). They include every case
 * of the snapshot tests in Jiff's `fmt::strtime::parse` module. Nothing here was computed by
 * the port.
 */
@IsTest
private class JiffStrtimeParserTest {
    /** Every field that is set, in a fixed order, as `name=value` pairs. */
    private static String describe(JiffBrokenDownTime tm) {
        List<String> parts = new List<String>();
        add(parts, 'year', tm.year());
        add(parts, 'month', tm.month());
        add(parts, 'day', tm.day());
        add(parts, 'doy', tm.dayOfYear());
        add(parts, 'isoyear', tm.isoWeekYear());
        add(parts, 'isoweek', tm.isoWeek());
        add(parts, 'sunweek', tm.sundayBasedWeek());
        add(parts, 'monweek', tm.mondayBasedWeek());
        add(parts, 'hour', tm.hour());
        add(parts, 'minute', tm.minute());
        add(parts, 'second', tm.second());
        add(parts, 'subsec', tm.subsecNanosecond());
        add(parts, 'offset', tm.offset() == null ? null : tm.offset().seconds());
        add(parts, 'iana', tm.ianaTimeZone());
        add(parts, 'weekday', tm.weekday());
        add(parts, 'meridiem', tm.meridiem());
        add(parts, 'timestamp', tm.timestamp());
        return parts.isEmpty() ? '(empty)' : String.join(parts, ' ');
    }

    private static void add(List<String> parts, String name, Object value) {
        if (value != null) {
            parts.add(name + '=' + String.valueOf(value));
        }
    }

    private static String parsed(String target, String format, String input) {
        try {
            JiffBrokenDownTime tm = JiffStrtimeParser.parse(format, input);
            if (target.equals('tm')) {
                return describe(tm);
            }
            if (target.equals('date')) {
                return tm.toDate().toString();
            }
            if (target.equals('time')) {
                return tm.toTime().toString();
            }
            if (target.equals('datetime')) {
                return tm.toDateTime().toString();
            }
            if (target.equals('timestamp')) {
                return tm.toTimestamp().toString();
            }
            return tm.toZonedDateTime().toString();
        } catch (JiffException e) {
            return 'ERR:' + e.getMessage();
        }
    }

    private static void assertParses(List<List<String>> rows) {
        List<String> failures = new List<String>();
        for (List<String> row : rows) {
            String actual = parsed(row[0], row[1], row[2]);
            if (!actual.equals(row[3])) {
                failures.add(
                    row[0] +
                        ' ' +
                        row[1] +
                        ' <' +
                        row[2] +
                        '>: expected [' +
                        row[3] +
                        '] got [' +
                        actual +
                        ']'
                );
            }
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

    @IsTest
    static void zonedDatetimesParseLikeJiff() {
        assertParses(
            new List<List<String>>{
                new List<String>{
                    'zoned',
                    '%h %d, %Y %H:%M:%S %z',
                    'Apr 1, 2022 20:46:15 -0400',
                    '2022-04-01T20:46:15-04:00[-04:00]'
                },
                new List<String>{
                    'zoned',
                    '%h %d, %Y %H:%M:%S %Q',
                    'Apr 1, 2022 20:46:15 -0400',
                    '2022-04-01T20:46:15-04:00[-04:00]'
                },
                new List<String>{
                    'zoned',
                    '%h %d, %Y %H:%M:%S [%Q]',
                    'Apr 1, 2022 20:46:15 [America/New_York]',
                    '2022-04-01T20:46:15-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%h %d, %Y %H:%M:%S %Q',
                    'Apr 1, 2022 20:46:15 America/New_York',
                    '2022-04-01T20:46:15-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%h %d, %Y %H:%M:%S %:z %:Q',
                    'Apr 1, 2022 20:46:15 -08:00 -04:00',
                    '2022-04-01T20:46:15-04:00[-04:00]'
                },
                new List<String>{
                    'zoned',
                    '%Y%m%d-%H%M%S%z',
                    '20240730-005625+0400',
                    '2024-07-30T00:56:25+04:00[+04:00]'
                },
                new List<String>{
                    'zoned',
                    '%F %H:%M %:z %:Q',
                    '2024-07-14 21:14 -04:00 America/New_York',
                    '2024-07-14T21:14:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%F %H:%M %:z %:Q',
                    '2024-07-14 21:14 -05:00 America/New_York',
                    'ERR:datetime could not resolve to a timestamp since `reject` conflict resolution was chosen, and because datetime has offset `-05`, but the time zone `America/New_York` for the given datetime unambiguously has offset `-04`'
                },
                new List<String>{
                    'zoned',
                    '%F %H:%M %:Q',
                    '2024-07-14 21:14 America/New_York',
                    '2024-07-14T21:14:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%A, %B %d, %Y at %-I:%M%P %:Q',
                    'Monday, July 15, 2024 at 5:30pm America/New_York',
                    '2024-07-15T17:30:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%a, %d %b %Y %T %z',
                    'Mon, 15 Jul 2024 16:24:59 -0400',
                    '2024-07-15T16:24:59-04:00[-04:00]'
                },
                new List<String>{
                    'zoned',
                    '%Y-%m-%dT%H:%M:%S%.f%:z',
                    '2024-07-15T16:24:59.123456789-04:00',
                    '2024-07-15T16:24:59.123456789-04:00[-04:00]'
                },
                new List<String>{
                    'zoned',
                    '%s',
                    '1760813400',
                    '2025-10-18T18:50:00Z[Etc/Unknown]'
                },
                new List<String>{
                    'zoned',
                    '%s %z',
                    '1760813400 -0400',
                    '2025-10-18T14:50:00-04:00[-04:00]'
                },
                new List<String>{
                    'zoned',
                    '%s %Q',
                    '1760813400 America/New_York',
                    '2025-10-18T14:50:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%s %z %Q',
                    '1720000000 -0400 America/New_York',
                    '2024-07-03T05:46:40-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%s %z %Q',
                    '1720000000 -0500 America/New_York',
                    'ERR:parsed time zone offset `-05`, but offset from timestamp and time zone is `-04`'
                },
                new List<String>{
                    'zoned',
                    '%Q',
                    'Foo/Bar',
                    'ERR:failed to find time zone `Foo/Bar` in time zone database'
                },
                new List<String>{
                    'zoned',
                    '%F %T %Q',
                    '2024-07-14 21:14:00 Foo/Bar',
                    'ERR:failed to find time zone `Foo/Bar` in time zone database'
                },
                new List<String>{
                    'zoned',
                    '%F',
                    '2024-07-14',
                    'ERR:either offset (from `%z`) or IANA time zone identifier (from `%Q`) is required for parsing zoned datetime'
                },
                new List<String>{
                    'zoned',
                    '%z',
                    '+0400',
                    'ERR:datetime required to parse zoned datetime: date required to parse datetime: year required to parse date'
                },
                new List<String>{
                    'zoned',
                    '%F %T %Q',
                    '2024-03-10 02:30:00 America/New_York',
                    '2024-03-10T03:30:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%F %T %Q',
                    '2024-11-03 01:30:00 America/New_York',
                    '2024-11-03T01:30:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%F %T %z %Q',
                    '2024-11-03 01:30:00 -0500 America/New_York',
                    '2024-11-03T01:30:00-05:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%F %T %z %Q',
                    '2024-11-03 01:30:00 -0400 America/New_York',
                    '2024-11-03T01:30:00-04:00[America/New_York]'
                },
                new List<String>{
                    'zoned',
                    '%F %T %Q',
                    '2024-07-14 21:14:00 UTC',
                    '2024-07-14T21:14:00+00:00[UTC]'
                },
                new List<String>{
                    'zoned',
                    '%F %T %Q',
                    '2024-07-14 21:14:00 Etc/Unknown',
                    '2024-07-14T21:14:00Z[Etc/Unknown]'
                },
                new List<String>{
                    'zoned',
                    '%F %T %:z',
                    '-009999-01-01 00:00:00 +25:00',
                    'ERR:strptime parsing failed: %F failed: expected to match literal byte `-` from format string, but found byte `9` in input'
                },
                new List<String>{
                    'zoned',
                    '%F %T %:z',
                    '9999-12-31 23:59:59 -25:00',
                    'ERR:parsed datetime and offset, but combining them into a zoned datetime is outside Jiff\'s supported timestamp range: converting datetime with time zone offset `-25` to timestamp overflowed: parameter \'Unix timestamp seconds\' is not in the required range of -377705023201..=253402207200'
                },
                new List<String>{
                    'zoned',
                    '%F %T %Q',
                    '2024-07-14 21:14:00 -04:30',
                    'ERR:strptime parsing failed: %Q failed: parsed hour component of time zone offset, but found colon after hours which is not allowed'
                },
                new List<String>{
                    'zoned',
                    '%F %T %:Q',
                    '2024-07-14 21:14:00 -04:30',
                    '2024-07-14T21:14:00-04:30[-04:30]'
                }
            }
        );
    }

    @IsTest
    static void timestampsParseLikeJiff() {
        assertParses(
            new List<List<String>>{
                new List<String>{
                    'timestamp',
                    '%h %d, %Y %H:%M:%S %z',
                    'Apr 1, 2022 20:46:15 -0400',
                    '2022-04-02T00:46:15Z'
                },
                new List<String>{
                    'timestamp',
                    '%h %d, %Y %H:%M:%S %z',
                    'Apr 1, 2022 20:46:15 +0400',
                    '2022-04-01T16:46:15Z'
                },
                new List<String>{
                    'timestamp',
                    '%h %d, %Y %H:%M:%S %z',
                    'Apr 1, 2022 20:46:15 -040059',
                    '2022-04-02T00:47:14Z'
                },
                new List<String>{
                    'timestamp',
                    '%h %d, %Y %H:%M:%S %:z',
                    'Apr 1, 2022 20:46:15 -04:00',
                    '2022-04-02T00:46:15Z'
                },
                new List<String>{
                    'timestamp',
                    '%h %d, %Y %H:%M:%S %:z',
                    'Apr 1, 2022 20:46:15 +04:00',
                    '2022-04-01T16:46:15Z'
                },
                new List<String>{
                    'timestamp',
                    '%h %d, %Y %H:%M:%S %:z',
                    'Apr 1, 2022 20:46:15 -04:00:59',
                    '2022-04-02T00:47:14Z'
                },
                new List<String>{ 'timestamp', '%s', '0', '1970-01-01T00:00:00Z' },
                new List<String>{ 'timestamp', '%s', '-0', '1970-01-01T00:00:00Z' },
                new List<String>{ 'timestamp', '%s', '-1', '1969-12-31T23:59:59Z' },
                new List<String>{ 'timestamp', '%s', '1', '1970-01-01T00:00:01Z' },
                new List<String>{ 'timestamp', '%s', '+1', '1970-01-01T00:00:01Z' },
                new List<String>{ 'timestamp', '%s', '1737396540', '2025-01-20T18:09:00Z' },
                new List<String>{ 'timestamp', '%s', '-377705023201', '-009999-01-02T01:59:59Z' },
                new List<String>{ 'timestamp', '%s', '253402207200', '9999-12-30T22:00:00Z' },
                new List<String>{ 'timestamp', '%s', ' 42', '1970-01-01T00:00:42Z' },
                new List<String>{ 'timestamp', '%3s', '12345', '1970-01-01T03:25:45Z' },
                new List<String>{ 'timestamp', '%_3s', '12345', '1970-01-01T03:25:45Z' },
                new List<String>{
                    'timestamp',
                    '%Y%m%d-%H%M%S%z',
                    '20240730-005625+0400',
                    '2024-07-29T20:56:25Z'
                },
                new List<String>{
                    'timestamp',
                    '%F %H:%M %:z',
                    '2024-07-14 21:14 -04:00',
                    '2024-07-15T01:14:00Z'
                },
                new List<String>{
                    'timestamp',
                    '%F %H:%M %:z and also %s',
                    '2024-07-14 21:14 -04:00 and also 1760377242',
                    '2025-10-13T17:40:42Z'
                },
                new List<String>{
                    'timestamp',
                    '%s and also %F %H:%M %:z',
                    '1760377242 and also 2024-07-14 21:14 -04:00',
                    '2025-10-13T17:40:42Z'
                },
                new List<String>{
                    'timestamp',
                    '%F',
                    '2024-07-14',
                    'ERR:offset required to parse timestamp'
                },
                new List<String>{
                    'timestamp',
                    '%z',
                    '+0400',
                    'ERR:datetime required to parse timestamp: date required to parse datetime: year required to parse date'
                },
                new List<String>{
                    'timestamp',
                    '%F %T %z',
                    '-009999-01-01 00:00:00 +0100',
                    'ERR:strptime parsing failed: %F failed: expected to match literal byte `-` from format string, but found byte `9` in input'
                },
                new List<String>{
                    'timestamp',
                    '%H:%M %z',
                    '12:00 +0000',
                    'ERR:datetime required to parse timestamp: date required to parse datetime: year required to parse date'
                }
            }
        );
    }

    @IsTest
    static void datetimesParseLikeJiff() {
        assertParses(
            new List<List<String>>{
                new List<String>{
                    'datetime',
                    '%h %d, %Y %H:%M:%S',
                    'Apr 1, 2022 20:46:15',
                    '2022-04-01T20:46:15'
                },
                new List<String>{
                    'datetime',
                    '%h %05d, %Y %H:%M:%S',
                    'Apr 1, 2022 20:46:15',
                    '2022-04-01T20:46:15'
                },
                new List<String>{
                    'datetime',
                    '%F %H:%M',
                    '2024-07-14 21:14',
                    '2024-07-14T21:14:00'
                },
                new List<String>{
                    'datetime',
                    '%Y年%m月%d日，%H时%M分%S秒',
                    '2022年02月04日，03时58分59秒',
                    '2022-02-04T03:58:59'
                },
                new List<String>{
                    'datetime',
                    '%M',
                    '4',
                    'ERR:date required to parse datetime: year required to parse date'
                },
                new List<String>{
                    'datetime',
                    '%H',
                    '4',
                    'ERR:date required to parse datetime: year required to parse date'
                },
                new List<String>{ 'datetime', '%F', '2024-07-14', '2024-07-14T00:00:00' },
                new List<String>{
                    'datetime',
                    '%F %M',
                    '2024-07-14 30',
                    'ERR:time required to parse datetime: parsing format did not include hour directive, but did include minute directive (cannot have smaller time units with bigger time units missing)'
                },
                new List<String>{
                    'datetime',
                    '%Y-%m-%d at %H:%M:%S',
                    '1970-01-01 at 01:00:00',
                    '1970-01-01T01:00:00'
                },
                new List<String>{ 'datetime', '%D %T', '07/14/24 12:00:00', '2024-07-14T12:00:00' }
            }
        );
    }

    @IsTest
