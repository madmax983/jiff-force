                    'ERR:weekday `Tuesday` is not valid for Monday based week number'
                }
            }
        );
    }

    @IsTest
    static void datesParseLikeJiff2() {
        assertParses(
            new List<List<String>>{
                new List<String>{
                    'date',
                    '%Y-%U-%u',
                    '2023-00-7',
                    'ERR:invalid date: parameter \'day-of-year\' is not in the required range of 1..=366'
                },
                new List<String>{ 'date', '%Y-%U-%a', '2023-01-Sun', '2023-01-01' },
                new List<String>{
                    'date',
                    '%Y-%W-%a',
                    '2024-00-Sun',
                    'ERR:weekday `Sunday` is not valid for Monday based week number'
                },
                new List<String>{ 'date', '%Y-%W-%a', '2024-52-Tue', '2024-12-24' },
                new List<String>{ 'date', '%Y-%W-%a', '2024-53-Tue', '2024-12-31' },
                new List<String>{ 'date', '%G-W%V-%u', '2020-W01-1', '2019-12-30' },
                new List<String>{ 'date', '%G-W%V-%u', '2020-W53-1', '2020-12-28' },
                new List<String>{
                    'date',
                    '%G-W%V-%u',
                    '2021-W53-1',
                    'ERR:invalid ISO 8601 week date: parameter \'iso-week\' is not in the required range of 1..=53'
                },
                new List<String>{ 'date', '%Y %G-W%V-%u', '2021 2020-W53-2', '2020-12-29' },
                new List<String>{ 'date', '%g-W%V-%u', '20-W10-3', '2020-03-04' },
                new List<String>{
                    'date',
                    '%G-W%V-%u',
                    '9999-W52-6',
                    'ERR:invalid ISO 8601 week date: parameter \'weekday (Monday 1-indexed)\' is not in the required range of 1..=7'
