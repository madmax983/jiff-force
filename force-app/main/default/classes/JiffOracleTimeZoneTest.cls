/**
 * Replays time zone vectors generated by the real Jiff crate (see `oracle/`) against the
 * port, for a fixed list of well known zones from 1970 through 2037: the offset either side
 * of every transition and at ordinary instants, and how civil datetimes in and around every
 * gap and fold map back to instants.
 *
 * The port asks the platform for zone rules where Jiff uses its bundled copy of the time zone
 * database, so these vectors hold only while the two agree. The zones and the period were
 * chosen because they do.
 *
 * A datetime's offsets are written `U:offset` when it is unambiguous, `G:before:after` in a
 * gap and `F:before:after` in a fold, in seconds; `JiffOracleSupport` describes the rest.
 */
@IsTest
private class JiffOracleTimeZoneTest {
    private static final Map<String, JiffTimeZone> ZONES = new Map<String, JiffTimeZone>();

    private static JiffTimeZone zone(String name) {
        if (!ZONES.containsKey(name)) {
            ZONES.put(name, JiffTimeZone.get(name));
        }
        return ZONES.get(name);
    }

    /** Writes the classification of a civil datetime the way the vectors do. */
    private static String describe(JiffAmbiguousOffset offset) {
        if (offset.isUnambiguous()) {
            return 'U:' + offset.offset().seconds();
        }
        return (offset.isGap() ? 'G:' : 'F:') +
            offset.before().seconds() +
            ':' +
            offset.after().seconds();
    }

    /**
     * Checks how `tz` resolves the civil datetime in field `at` of a row against the four
     * fields after it: its offsets and the timestamps chosen by each strategy.
     */
    private static void checkCivil(JiffTimeZone tz, List<String> f, Integer at, String row) {
        JiffDateTime dt = JiffOracleSupport.toDateTime(f.get(at));
        Assert.areEqual(f.get(at), dt.toString(), 'text of the datetime of ' + row);
        JiffAmbiguousTimestamp ambiguous = tz.toAmbiguousTimestamp(dt);
        String what = ' of ' + f.get(at) + ' in ' + row;
        Assert.areEqual(f.get(at + 1), describe(ambiguous.offset()), 'offsets' + what);
        Assert.areEqual(
            !f.get(at + 1).startsWith('U'),
            ambiguous.isAmbiguous(),
            'ambiguity' + what
        );
        Assert.areEqual(
            f.get(at + 2),
            JiffOracleSupport.timestampText(ambiguous.compatible()),
            'compatible' + what
        );
        Assert.areEqual(
            f.get(at + 2),
            JiffOracleSupport.timestampText(tz.toTimestamp(dt)),
            'toTimestamp' + what
        );
        Assert.areEqual(
            f.get(at + 3),
            JiffOracleSupport.timestampText(ambiguous.earlier()),
            'earlier' + what
        );
        Assert.areEqual(
            f.get(at + 4),
            JiffOracleSupport.timestampText(ambiguous.later()),
            'later' + what
        );
        if (!ambiguous.isAmbiguous()) {
            // Exactly one instant shows this reading, so the instant leads back to it.
            Assert.areEqual(dt, tz.toDateTime(ambiguous.unambiguous()), 'round trip' + what);
        }
    }

    /**
     * Checks that searching from either side of the transition in a row finds it, and that
     * searching back from the transition itself finds the one in the row before, which is
     * `earlier` seconds into the epoch (null when the row is the first of its zone).
     */
    private static void checkSearch(JiffTimeZone tz, List<String> f, Long earlier, String row) {
        Long second = Long.valueOf(f.get(1));
        JiffTimeZoneTransition next = tz.nextTransition(JiffTimestamp.fromSecond(second - 1));
        Assert.areEqual(second, next.toTimestamp().asSecond(), 'next transition of ' + row);
        Assert.areEqual(
            Integer.valueOf(f.get(3)),
            next.offset().seconds(),
            'offset of the next transition of ' + row
        );
        JiffTimeZoneTransition previous = tz.previousTransition(
            JiffTimestamp.fromSecond(second + 1)
        );
        Assert.areEqual(second, previous.toTimestamp().asSecond(), 'previous transition of ' + row);
        if (earlier != null) {
            // "Previous" and "next" are strict, so the search steps over this transition.
            Assert.areEqual(
                earlier,
                tz.previousTransition(JiffTimestamp.fromSecond(second)).toTimestamp().asSecond(),
                'transition before ' + row
            );
            Assert.areEqual(
                second,
                tz.nextTransition(JiffTimestamp.fromSecond(earlier)).toTimestamp().asSecond(),
                'transition after the one before ' + row
            );
        }
    }

    /** Replays the transition rows of the zone called `name`, and says how many there were. */
    private static Integer replayTransitions(List<String> rows, String name) {
        String earlierZone = '';
        Long earlier = null;
        Integer replayed = 0;
        for (String row : rows) {
            if (!row.startsWith(name + '|')) {
                continue;
            }
            replayed++;
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimeZone tz = zone(f.get(0));
            Long second = Long.valueOf(f.get(1));
            // Rows are in order of time within each zone.
            checkSearch(tz, f, earlierZone.equals(f.get(0)) ? earlier : null, row);
            earlierZone = f.get(0);
            earlier = second;
            Assert.areEqual(
                Integer.valueOf(f.get(2)),
                tz.toOffset(JiffTimestamp.fromSecond(second - 1)).seconds(),
                'offset before the transition of ' + row
            );
            Assert.areEqual(
                Integer.valueOf(f.get(2)),
                tz.toOffset(JiffTimestamp.newInstance(second - 1, 999999999)).seconds(),
                'offset a nanosecond before the transition of ' + row
            );
            Assert.areEqual(
                Integer.valueOf(f.get(3)),
                tz.toOffset(JiffTimestamp.fromSecond(second)).seconds(),
                'offset at the transition of ' + row
            );
            checkCivil(tz, f, 4, row);
            checkCivil(tz, f, 9, row);
        }
        return replayed;
    }

    // New York and Sao Paulo are on opposite sides of the equator, so between them they have
    // gaps and folds in both halves of the year. Sao Paulo stopped changing in 2019.
    @IsTest
    static void transitionsInTheAmericasAgreeWithJiff() {
        List<String> rows = JiffOracleTimeZoneAmericasData.rows();
        Assert.areEqual(136, replayTransitions(rows, 'America/New_York'), 'New York');
        Assert.areEqual(68, replayTransitions(rows, 'America/Sao_Paulo'), 'Sao Paulo');
    }

    @IsTest
    static void transitionsInLondonAgreeWithJiff() {
        List<String> rows = JiffOracleTimeZoneEuropeData.rows();
        Assert.areEqual(133, replayTransitions(rows, 'Europe/London'), 'London');
    }

    // Dublin keeps the same clock as London, but the time zone database describes its winter
    // time as the exception rather than its summer time.
    @IsTest
    static void transitionsInDublinAgreeWithJiff() {
        List<String> rows = JiffOracleTimeZoneEuropeData.rows();
        Assert.areEqual(133, replayTransitions(rows, 'Europe/Dublin'), 'Dublin');
    }

    // Apia includes the day in 2011 that Samoa skipped to cross the date line: a gap of 24
    // hours.
    @IsTest
    static void transitionsInThePacificAgreeWithJiff() {
        List<String> rows = JiffOracleTimeZonePacificData.rows();
        Assert.areEqual(133, replayTransitions(rows, 'Australia/Sydney'), 'Sydney');
        Assert.areEqual(23, replayTransitions(rows, 'Pacific/Apia'), 'Apia');
    }

    @IsTest
    static void offsetsAtInstantsAgreeWithJiff() {
        List<String> rows = JiffOracleTimeZoneOffsetData.rows();
        Assert.isTrue(rows.size() >= 360, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimeZone tz = zone(f.get(0));
            JiffTimestamp ts = JiffOracleSupport.toTimestamp(f.get(1));
            Assert.areEqual(
                Integer.valueOf(f.get(2)),
                tz.toOffset(ts).seconds(),
                'offset of ' + row
            );
            Assert.areEqual(
                Integer.valueOf(f.get(2)),
                tz.toOffsetInfo(ts).offset().seconds(),
                'offset in the offset info of ' + row
            );
        }
    }

    @IsTest
    static void civilDatetimesAgreeWithJiff() {
        List<String> rows = JiffOracleTimeZoneCivilData.rows();
        Assert.isTrue(rows.size() >= 360, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            checkCivil(zone(f.get(0)), f, 1, row);
        }
    }
}
