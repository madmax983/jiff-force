/**
 * Printing with `JiffTemporalPrinter`: the defaults, and the lowercase, separator and
 * precision options, for every type it prints.
 *
 * The tables are `options|value => expected`. `options` is `default` or a comma separated
 * list of `lower`, `sep=<char>` and `prec=<digits>`. Each expected value is the output of
 * Jiff 1.0.0's `DateTimePrinter` configured the same way (`date_to_string`, `time_to_string`,
 * `datetime_to_string`, `timestamp_to_string`, `timestamp_with_offset_to_string`,
 * `time_zone_to_string` and `pieces_to_string`), generated by running the real crate. The
 * remaining assertions are the examples in the doc comments of `fmt/temporal/mod.rs`.
 */
@IsTest
private class JiffTemporalPrinterTest {
    private static JiffTemporalPrinter printer(String options) {
        JiffTemporalPrinter out = new JiffTemporalPrinter();
        for (String option : options.split(',')) {
            if (option.equals('lower')) {
                out = out.lowercase(true);
            } else if (option.startsWith('sep=')) {
                out = out.separator(option.substring(4));
            } else if (option.startsWith('prec=')) {
                out = out.precision(Integer.valueOf(option.substring(5)));
            }
        }
        return out;
    }

    private static String print(String kind, JiffTemporalPrinter options, String value) {
        if (kind.equals('date')) {
            return options.dateToString(JiffDate.parse(value));
        }
        if (kind.equals('time')) {
            return options.timeToString(JiffTime.parse(value));
        }
        if (kind.equals('datetime')) {
            return options.dateTimeToString(JiffDateTime.parse(value));
        }
        if (kind.equals('timestamp')) {
            return options.timestampToString(JiffTimestamp.parse(value));
        }
        if (kind.equals('timestampWithOffset')) {
            Integer at = value.indexOf('@');
            return options.timestampWithOffsetToString(
                JiffTimestamp.parse(value.substring(0, at)),
                JiffOffset.fromSeconds(Integer.valueOf(value.substring(at + 1)))
            );
        }
        if (kind.equals('zone')) {
            return options.timeZoneToString(JiffTemporal.parseTimeZone(value));
        }
        return options.piecesToString(JiffPieces.parse(value));
    }

    private static void assertPrints(String kind, List<String> rows) {
        for (String row : rows) {
            Integer bar = row.indexOf('|');
            Integer at = row.indexOf(' => ');
            Assert.areEqual(
                row.substring(at + 4),
                print(kind, printer(row.substring(0, bar)), row.substring(bar + 1, at)),
                row
            );
        }
    }

    @IsTest
    static void datesPrintTheSameWhateverTheOptions() {
        assertPrints(
            'date',
            new List<String>{
                'default|2024-06-19 => 2024-06-19',
                'default|0000-01-01 => 0000-01-01',
                'default|0001-02-03 => 0001-02-03',
                'default|9999-12-31 => 9999-12-31',
                'default|-000001-01-01 => -000001-01-01',
                'default|-000044-03-15 => -000044-03-15',
                'default|-009999-01-01 => -009999-01-01',
                'lower,sep=x,prec=9|2024-06-19 => 2024-06-19'
            }
        );
    }

