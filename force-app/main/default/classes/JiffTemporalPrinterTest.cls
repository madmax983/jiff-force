    @IsTest
    static void weekDatesPrintWithAnUpperOrLowerCaseWeekPrefix() {
        // The uppercase forms are `ISOWeekDate`'s `Display` output in Jiff. Jiff's lowercase
        // week date printer is not public, so the lowercase forms cannot be generated by
        // running it; they follow `print_iso_week_date_buf` in `fmt/temporal/printer.rs`,
        // which writes `w` instead of `W` and changes nothing else.
        JiffIsoWeekDate saturday = JiffIsoWeekDate.newInstance(2024, 10, JiffWeekday.SATURDAY);
        JiffIsoWeekDate first = JiffIsoWeekDate.MIN;
        JiffIsoWeekDate last = JiffIsoWeekDate.MAX;
        JiffTemporalPrinter upper = new JiffTemporalPrinter();
        JiffTemporalPrinter lower = upper.lowercase(true).precision(3).separator(' ');
        Assert.areEqual('2024-W10-6', upper.isoWeekDateToString(saturday));
        Assert.areEqual('-009999-W01-1', upper.isoWeekDateToString(first));
        Assert.areEqual('9999-W52-5', upper.isoWeekDateToString(last));
        Assert.areEqual('2024-w10-6', lower.isoWeekDateToString(saturday));
        Assert.areEqual('-009999-w01-1', lower.isoWeekDateToString(first));
        Assert.areEqual('9999-w52-5', lower.isoWeekDateToString(last));
        // Jiff's parser reads both back.
        Assert.areEqual(saturday, JiffIsoWeekDate.parse(lower.isoWeekDateToString(saturday)));
    }

    @IsTest
    static void theDocumentedExamplesOfEachOptionPrintAsInJiff() {
        // `DateTimePrinter::lowercase`, `separator` and `precision` are documented with a zoned
        // datetime, 2024-06-15T07:00:00.123456789-04:00[America/New_York]. Its pieces print
        // the same way.
        JiffPieces pieces = JiffPieces.fromDateTime(
                JiffDateTime.newInstance(2024, 6, 15, 7, 0, 0, 0)
            )
            .withOffset(JiffOffset.fromHours(-4))
            .withTimeZoneName('America/New_York');
        Assert.areEqual(
            '2024-06-15t07:00:00-04:00[America/New_York]',
            new JiffTemporalPrinter().lowercase(true).piecesToString(pieces)
        );
        Assert.areEqual(
            '2024-06-15~07:00:00-04:00[America/New_York]',
            new JiffTemporalPrinter().separator('~').piecesToString(pieces)
        );
        JiffPieces fractional = pieces.withTime(JiffTime.newInstance(7, 0, 0, 123456789));
        Assert.areEqual(
            '2024-06-15T07:00:00.123-04:00[America/New_York]',
            new JiffTemporalPrinter().precision(3).piecesToString(fractional)
        );
        JiffPieces millis = pieces.withTime(JiffTime.newInstance(7, 0, 0, 123000000));
        Assert.areEqual(
            '2024-06-15T07:00:00.123000-04:00[America/New_York]',
            new JiffTemporalPrinter().precision(6).piecesToString(millis)
        );
        // Precision values greater than 9 are clamped to 9.
        Assert.areEqual(
            '2024-06-15T07:00:00.123000000-04:00[America/New_York]',
            new JiffTemporalPrinter().precision(300).piecesToString(millis)
        );
        // A precision of 0 implies the entire fractional component is always truncated.
        Assert.areEqual(
            '2024-06-15T07:00:00-04:00[America/New_York]',
            new JiffTemporalPrinter().precision(0).piecesToString(millis)
        );
    }

    @IsTest
    static void optionsReturnANewPrinterAndLeaveTheOriginalAlone() {
        JiffDateTime dt = JiffDateTime.newInstance(2024, 6, 15, 7, 0, 0, 500000000);
        JiffTemporalPrinter base = new JiffTemporalPrinter();
        JiffTemporalPrinter changed = base.lowercase(true).separator(' ').precision(2);
        Assert.areEqual('2024-06-15T07:00:00.5', base.dateTimeToString(dt));
        Assert.areEqual('2024-06-15 07:00:00.50', changed.dateTimeToString(dt));
        // Each option can be undone.
        JiffTemporalPrinter restored = changed.lowercase(false).separator('T').precision(null);
        Assert.areEqual('2024-06-15T07:00:00.5', restored.dateTimeToString(dt));
    }

    @IsTest
    static void aSeparatorMustBeOneAsciiCharacter() {
        for (String bad : new List<String>{ null, '', 'TT', 'é', ' ' }) {
            try {
                new JiffTemporalPrinter().separator(bad);
                Assert.fail('expected the separator to be rejected: ' + bad);
            } catch (JiffException e) {
                Assert.areEqual(
                    'RFC 3339 separator must be a single ASCII character',
                    e.getMessage()
                );
            }
        }
    }

    @IsTest
    static void aNegativePrecisionIsRejected() {
        try {
            new JiffTemporalPrinter().precision(-1);
            Assert.fail('expected a negative precision to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'the precision of fractional seconds must not be negative',
                e.getMessage()
            );
        }
    }

    /** Prints a null with the method numbered `which`, for the test below. */
    private static String printNull(Integer which) {
        JiffTemporalPrinter printer = new JiffTemporalPrinter();
        if (which == 0) {
            return printer.dateToString(null);
        } else if (which == 1) {
            return printer.timeToString(null);
        } else if (which == 2) {
            return printer.dateTimeToString(null);
        } else if (which == 3) {
            return printer.timestampToString(null);
        } else if (which == 4) {
            return printer.timestampWithOffsetToString(null, JiffOffset.UTC);
        } else if (which == 5) {
            return printer.timestampWithOffsetToString(JiffTimestamp.UNIX_EPOCH, null);
        } else if (which == 6) {
            return printer.isoWeekDateToString(null);
        } else if (which == 7) {
            return printer.timeZoneToString(null);
        } else if (which == 8) {
            return printer.piecesToString(null);
        } else if (which == 9) {
            return JiffTemporal.printDate(null);
        } else if (which == 10) {
            return JiffTemporal.printOffset(null);
        } else if (which == 11) {
            return JiffTemporal.printTimestampWithOffset(JiffTimestamp.UNIX_EPOCH, null);
        }
        return JiffTemporal.printPieces(null);
    }

    @IsTest
    static void aNullValueIsRejectedByEveryPrintingMethod() {
        List<String> expected = new List<String>{
            'cannot print a null date',
            'cannot print a null time',
            'cannot print a null datetime',
            'cannot print a null timestamp',
            'cannot print a null timestamp',
            'cannot print a null offset',
            'cannot print a null ISO week date',
            'cannot print a null time zone',
            'cannot print null datetime pieces',
            'cannot print a null date',
            'cannot print a null offset',
            'cannot print a null offset',
            'cannot print null datetime pieces'
        };
        for (Integer which = 0; which < expected.size(); which++) {
            try {
                String printed = printNull(which);
                Assert.fail('expected null to be rejected by method ' + which + ': ' + printed);
            } catch (JiffException e) {
                Assert.areEqual(expected.get(which), e.getMessage(), 'method ' + which);
            }
        }
    }

    @IsTest
    static void theLowercaseOptionMustNotBeNull() {
        try {
            new JiffTemporalPrinter().lowercase(null);
            Assert.fail('expected a null lowercase option to be rejected');
        } catch (JiffException e) {
            Assert.areEqual('the lowercase option must be true or false, not null', e.getMessage());
        }
    }

    @IsTest
    static void theDefaultPrinterIsWhatToStringUses() {
        JiffTemporalPrinter printer = new JiffTemporalPrinter();
        JiffDateTime dt = JiffDateTime.newInstance(2024, 2, 29, 15, 22, 45, 123000000);
        JiffTimestamp ts = JiffTimestamp.fromMillisecond(1720493204500L);
        Assert.areEqual(dt.toDate().toString(), printer.dateToString(dt.toDate()));
        Assert.areEqual(dt.toTime().toString(), printer.timeToString(dt.toTime()));
        Assert.areEqual(dt.toString(), printer.dateTimeToString(dt));
        Assert.areEqual(ts.toString(), printer.timestampToString(ts));
        Assert.areEqual(
            ts.toStringWithOffset(JiffOffset.fromHours(-4)),
            printer.timestampWithOffsetToString(ts, JiffOffset.fromHours(-4))
        );
        Assert.areEqual(
            JiffIsoWeekDate.fromDate(dt.toDate()).toString(),
            printer.isoWeekDateToString(JiffIsoWeekDate.fromDate(dt.toDate()))
        );
        Assert.areEqual('2024-02-29', JiffTemporal.printDate(dt.toDate()));
        Assert.areEqual('15:22:45.123', JiffTemporal.printTime(dt.toTime()));
        Assert.areEqual('2024-02-29T15:22:45.123', JiffTemporal.printDateTime(dt));
        Assert.areEqual('2024-07-09T02:46:44.5Z', JiffTemporal.printTimestamp(ts));
        Assert.areEqual(
            '2024-07-08T22:46:44.5-04:00',
            JiffTemporal.printTimestampWithOffset(ts, JiffOffset.fromHours(-4))
        );
        Assert.areEqual(
            '2024-W09-4',
            JiffTemporal.printIsoWeekDate(JiffIsoWeekDate.fromDate(dt.toDate()))
        );
        Assert.areEqual('Etc/Unknown', JiffTemporal.printTimeZone(JiffTimeZone.unknown()));
        Assert.areEqual(
            '2024-02-29T15:22:45.123',
            JiffTemporal.printPieces(JiffPieces.fromDateTime(dt))
        );
    }
}
