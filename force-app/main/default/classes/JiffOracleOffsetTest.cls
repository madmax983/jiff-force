/**
 * Replays UTC offset vectors generated by the real Jiff crate (see `oracle/`) against the
 * port. Offsets are written as seconds east of UTC. `ERR` in a vector means Jiff reported
 * an error; `JiffOracleSupport` describes how the other values are written.
 */
@IsTest
private class JiffOracleOffsetTest {
    private static final List<String> OPERATIONS = new List<String>{
        'add',
        'subtract',
        'saturatingAdd',
        'saturatingSubtract'
    };

    /** Builds an offset with the named constructor; a thrown exception is the caller's. */
    private static JiffOffset construct(String constructor, String argument) {
        if (constructor.equals('HOURS')) {
            return JiffOffset.fromHours(Integer.valueOf(argument));
        } else if (constructor.equals('SECONDS')) {
            return JiffOffset.fromSeconds(Integer.valueOf(argument));
        }
        Assert.areEqual('DURATION', constructor, 'unknown constructor in a vector');
        return JiffOffset.fromDuration(JiffOracleSupport.toDuration(argument));
    }

    @IsTest
    static void constructionAndPrintingAgreeWithJiff() {
        List<String> rows = JiffOracleOffsetData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffOffset offset;
            try {
                offset = construct(f.get(0), f.get(1));
            } catch (JiffException e) {
                Assert.areEqual(JiffOracleSupport.ERR, f.get(2), 'rejected ' + row);
                continue;
            }
            Assert.areEqual(f.get(2), String.valueOf(offset.seconds()), 'seconds of ' + row);
            Assert.areEqual(f.get(3), offset.toString(), 'text of ' + row);
            Assert.areEqual(
                Integer.valueOf(f.get(4)),
                offset.negate().seconds(),
                'negation of ' + row
            );
            Integer signum = Integer.valueOf(f.get(5));
            Assert.areEqual(signum, offset.signum(), 'signum of ' + row);
            Assert.areEqual(signum > 0, offset.isPositive(), 'isPositive of ' + row);
            Assert.areEqual(signum < 0, offset.isNegative(), 'isNegative of ' + row);
            Assert.areEqual(signum == 0, offset.isZero(), 'isZero of ' + row);
        }
    }

    /** One of the four ways of adding a span, with `ERR` for a thrown exception. */
    private static String withSpan(String op, JiffOffset offset, JiffSpan span) {
        try {
            if (op.equals('add')) {
                return String.valueOf(offset.add(span).seconds());
            } else if (op.equals('subtract')) {
                return String.valueOf(offset.subtract(span).seconds());
            } else if (op.equals('saturatingAdd')) {
                return String.valueOf(offset.saturatingAdd(span).seconds());
            }
            return String.valueOf(offset.saturatingSubtract(span).seconds());
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    /** One of the four ways of adding a duration, with `ERR` for a thrown exception. */
    private static String withDuration(String op, JiffOffset offset, JiffSignedDuration duration) {
        try {
            if (op.equals('add')) {
                return String.valueOf(offset.add(duration).seconds());
            } else if (op.equals('subtract')) {
                return String.valueOf(offset.subtract(duration).seconds());
            } else if (op.equals('saturatingAdd')) {
                return String.valueOf(offset.saturatingAdd(duration).seconds());
            }
            return String.valueOf(offset.saturatingSubtract(duration).seconds());
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void arithmeticAgreesWithJiff() {
        List<String> rows = JiffOracleOffsetArithmeticData.rows();
        Assert.isTrue(rows.size() >= 340, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffOffset offset = JiffOffset.fromSeconds(Integer.valueOf(f.get(0)));
            JiffSpan span = JiffOracleSupport.toSpan(f.get(1));
            JiffSignedDuration duration = JiffOracleSupport.toDuration(f.get(6));
            for (Integer i = 0; i < OPERATIONS.size(); i++) {
                String op = OPERATIONS.get(i);
                Assert.areEqual(
                    f.get(2 + i),
                    withSpan(op, offset, span),
                    op + ' of the span of ' + row
                );
                Assert.areEqual(
                    f.get(7 + i),
                    withDuration(op, offset, duration),
                    op + ' of the duration of ' + row
                );
            }
            JiffOffset other = JiffOffset.fromSeconds(Integer.valueOf(f.get(11)));
            Assert.areEqual(
                f.get(12),
                JiffOracleSupport.spanText(offset.until(other)),
                'until of ' + row
            );
            Assert.areEqual(
                f.get(13),
                JiffOracleSupport.spanText(offset.since(other)),
                'since of ' + row
            );
            Assert.areEqual(
                f.get(14),
                JiffOracleSupport.durationText(offset.durationUntil(other)),
                'duration until of ' + row
            );
            Assert.areEqual(
                f.get(14),
                JiffOracleSupport.durationText(other.durationSince(offset)),
                'duration since of ' + row
            );
        }
    }

    @IsTest
    static void roundingAgreesWithJiff() {
        List<String> rows = JiffOracleOffsetRoundData.rows();
        Assert.isTrue(rows.size() >= 360, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffOffset offset = JiffOffset.fromSeconds(Integer.valueOf(f.get(0)));
            JiffRound options = JiffRound.to(JiffOracleSupport.unit(f.get(1)))
                .increment(Long.valueOf(f.get(2)))
                .mode(JiffOracleSupport.mode(f.get(3)));
            String actual;
            try {
                actual = String.valueOf(offset.round(options).seconds());
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(4), actual, 'rounding of ' + row);
        }
    }
}
