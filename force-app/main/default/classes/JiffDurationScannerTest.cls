/**
 * The cursor shared by the two duration parsers. The escaping expectations were generated by
 * running Jiff 1.0.0 on inputs with the same unexpected characters.
 */
@IsTest
private class JiffDurationScannerTest {
    private static String chars(List<Integer> codeUnits) {
        return String.fromCharArray(codeUnits);
    }

    @IsTest
    static void peeksAndAdvancesThroughTheInput() {
        JiffDurationScanner scanner = new JiffDurationScanner('ab');
        Assert.isFalse(scanner.isDone());
        Assert.areEqual(0, scanner.position());
        Assert.areEqual(97, scanner.peek());
        scanner.advance(1);
        Assert.areEqual(98, scanner.peek());
        Assert.areEqual(1, scanner.position());
        scanner.advance(1);
        Assert.isTrue(scanner.isDone());
        Assert.areEqual(-1, scanner.peek());
        scanner.rewind(1);
        Assert.areEqual(98, scanner.peek());
        Assert.isTrue(new JiffDurationScanner('').isDone());
    }

    @IsTest
    static void eatsOnlyWhatMatches() {
        JiffDurationScanner scanner = new JiffDurationScanner('+PT ago');
        Assert.isFalse(scanner.eat(45));
        Assert.isTrue(scanner.eat(43));
        Assert.isFalse(scanner.eatEither(84, 116));
        Assert.isTrue(scanner.eatEither(80, 112));
        Assert.isTrue(scanner.eatEither(116, 84));
        Assert.isFalse(scanner.eatText('ago'));
        Assert.areEqual(' ago', scanner.upcoming(12));
        Assert.areEqual(' a', scanner.upcoming(2));
        scanner.advance(1);
        Assert.isFalse(scanner.eatText('agoo'));
        Assert.isTrue(scanner.eatText('ago'));
        Assert.isTrue(scanner.isDone());
        Assert.isFalse(scanner.eat(43));
        Assert.isFalse(scanner.eatText('a'));
        Assert.areEqual('', scanner.upcoming(3));
    }

    @IsTest
    static void whitespaceIsSpaceTabLineFeedFormFeedAndCarriageReturn() {
        for (Integer ch : new List<Integer>{ 32, 9, 10, 12, 13 }) {
            Assert.isTrue(new JiffDurationScanner(chars(new List<Integer>{ ch })).isAtWhitespace());
        }
        // Vertical tab and no-break space are not.
        for (Integer ch : new List<Integer>{ 11, 160, 97 }) {
            Assert.isFalse(
                new JiffDurationScanner(chars(new List<Integer>{ ch })).isAtWhitespace()
            );
        }
        Assert.isFalse(new JiffDurationScanner('').isAtWhitespace());
        JiffDurationScanner scanner = new JiffDurationScanner(' \t\n\f\r x');
        scanner.skipWhitespace();
        Assert.areEqual(120, scanner.peek());
        scanner.skipWhitespace();
        Assert.areEqual(120, scanner.peek());
    }

    @IsTest
    static void unitValuesAreRunsOfAsciiDigits() {
        JiffDurationScanner scanner = new JiffDurationScanner('0123x');
        Assert.areEqual(JiffI128.valueOf(123L), scanner.unitValue());
        Assert.areEqual(120, scanner.peek());
        Assert.isNull(scanner.unitValue());
        Assert.areEqual(4, scanner.position());
        Assert.isNull(new JiffDurationScanner('').unitValue());
        Assert.isNull(new JiffDurationScanner('-1').unitValue());
        // Digits outside ASCII are not digits here.
        Assert.isNull(new JiffDurationScanner(chars(new List<Integer>{ 1633 })).unitValue());
    }

    @IsTest
    static void unitValuesMayBeAsLargeAsAnUnsigned64BitInteger() {
        Assert.areEqual(
            '9223372036854775808',
            new JiffDurationScanner('9223372036854775808').unitValue().toString()
        );
        Assert.areEqual(
            '18446744073709551615',
            new JiffDurationScanner('18446744073709551615').unitValue().toString()
        );
        try {
            new JiffDurationScanner('18446744073709551616').unitValue();
            Assert.fail('expected a value beyond 64 bits to be rejected');
        } catch (JiffException e) {
            Assert.areEqual('number too big to parse into 64-bit integer', e.getMessage());
        }
    }

    @IsTest
    static void atMostTwentyOneDigitsAreReadForOneValue() {
        // Jiff parses `000000000000000000001s` as one second ...
        JiffDurationScanner fits = new JiffDurationScanner('000000000000000000001s');
        Assert.areEqual(JiffI128.ONE, fits.unitValue());
        Assert.areEqual(115, fits.peek());
        // ... but with one more zero it stops before the last digit, which then cannot be a
        // unit label.
        JiffDurationScanner tooLong = new JiffDurationScanner('0000000000000000000001s');
        Assert.areEqual(JiffI128.ZERO, tooLong.unitValue());
        Assert.areEqual(49, tooLong.peek());
    }

    @IsTest
    static void fractionsAreScaledToNineDigits() {
        JiffDurationScanner half = new JiffDurationScanner('.5s');
        Assert.areEqual(500000000, half.fraction());
        Assert.areEqual(115, half.peek());
        Assert.areEqual(123456789, new JiffDurationScanner(',123456789').fraction());
        Assert.areEqual(1, new JiffDurationScanner('.000000001').fraction());
        Assert.areEqual(0, new JiffDurationScanner('.0').fraction());
        Assert.areEqual(2100000, new JiffDurationScanner('.0021').fraction());
        // The tenth digit is left for the caller to trip over.
        JiffDurationScanner tenDigits = new JiffDurationScanner('.1234567891');
        Assert.areEqual(123456789, tenDigits.fraction());
        Assert.areEqual(49, tenDigits.peek());
    }

    @IsTest
    static void aFractionNeedsASeparatorAndAtLeastOneDigit() {
        JiffDurationScanner none = new JiffDurationScanner('5.5');
        Assert.areEqual(-1, none.fraction());
        Assert.areEqual(0, none.position());
        Assert.areEqual(-1, new JiffDurationScanner('').fraction());
        for (String text : new List<String>{ '.', ',', '.s', ',-1' }) {
            try {
                new JiffDurationScanner(text).fraction();
                Assert.fail('expected a bare decimal separator to be rejected: ' + text);
            } catch (JiffException e) {
                Assert.areEqual(
                    'found decimal after seconds component, ' +
                    'but did not find any digits after decimal',
                    e.getMessage()
                );
            }
        }
    }

    @IsTest
    static void finishRequiresTheWholeInputToBeConsumed() {
        JiffDurationScanner scanner = new JiffDurationScanner('1h nt');
        scanner.advance(5);
        scanner.finish('PT1H');
        scanner.rewind(2);
        try {
            scanner.finish('PT1H');
            Assert.fail('expected leftover input to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'parsed value \'PT1H\', but unparsed input " nt" remains ' +
                '(expected no unparsed input)',
                e.getMessage()
            );
        }
    }

    @IsTest
    static void leftoverInputIsQuotedWithEscapes() {
        Assert.areEqual('"nt"', JiffDurationScanner.quote('nt'));
        Assert.areEqual('""', JiffDurationScanner.quote(''));
        Assert.areEqual('"\\"\\\'\\\\\\\\x"', JiffDurationScanner.quote('"\'\\\\x'));
        Assert.areEqual('"\\0"', JiffDurationScanner.quote(chars(new List<Integer>{ 0 })));
        // Control characters are escaped; everything outside ASCII is kept as it is.
        String mixed = chars(new List<Integer>{ 1, 127, 181, 55357, 56832, 32, 9, 10, 13 });
        Assert.areEqual(
            '"\\x01\\x7f' + chars(new List<Integer>{ 181, 55357, 56832 }) + ' \\t\\n\\r"',
            JiffDurationScanner.quote(mixed)
        );
    }

    @IsTest
    static void aSingleByteIsEscapedWithUppercaseHex() {
        Map<Integer, String> expected = new Map<Integer, String>{
            97 => 'a',
            49 => '1',
            32 => ' ',
            126 => '~',
            9 => '\\t',
            10 => '\\n',
            13 => '\\r',
            39 => '\\\'',
            34 => '\\"',
            92 => '\\\\',
            1 => '\\x01',
            27 => '\\x1B',
            127 => '\\x7F',
            194 => '\\xC2',
            255 => '\\xFF'
        };
        for (Integer value : expected.keySet()) {
            Assert.areEqual(expected.get(value), JiffDurationScanner.escapeByte(value));
        }
    }

    @IsTest
    static void theNextCharacterIsDescribedByItsFirstUtf8Byte() {
        Assert.areEqual('1', new JiffDurationScanner('1').describeNext());
        Assert.areEqual('\\t', new JiffDurationScanner('\t').describeNext());
        // Code points and the leading byte Jiff reports for each: U+00B5, U+00FF, U+07FF
        // (two bytes), U+0800, U+20AC, U+FFFD (three bytes).
        Map<Integer, String> expected = new Map<Integer, String>{
            181 => '\\xC2',
            255 => '\\xC3',
            2047 => '\\xDF',
            2048 => '\\xE0',
            8364 => '\\xE2',
            65533 => '\\xEF'
        };
        for (Integer codeUnit : expected.keySet()) {
            Assert.areEqual(
                expected.get(codeUnit),
                new JiffDurationScanner(chars(new List<Integer>{ codeUnit })).describeNext()
            );
        }
        // Four bytes, written in UTF-16 as a surrogate pair: U+1F600 and U+10FFFF.
        Assert.areEqual(
            '\\xF0',
            new JiffDurationScanner(chars(new List<Integer>{ 55357, 56832 })).describeNext()
        );
        Assert.areEqual(
            '\\xF4',
            new JiffDurationScanner(chars(new List<Integer>{ 56319, 57343 })).describeNext()
        );
        JiffDurationScanner second = new JiffDurationScanner('a' + chars(new List<Integer>{ 181 }));
        second.advance(1);
        Assert.areEqual('\\xC2', second.describeNext());
    }

    @IsTest
    static void aNullInputIsRejected() {
        try {
            JiffDurationScanner scanner = new JiffDurationScanner(null);
            Assert.fail('expected null to be rejected, got ' + scanner);
        } catch (JiffException e) {
            Assert.areEqual('cannot parse a duration from a null string', e.getMessage());
        }
    }
}
