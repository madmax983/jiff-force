/**
 * `JiffTemporalOffsetParser`: parsing a UTC offset from the start of some text, under each
 * combination of options the library uses.
 *
 * - The default parser's cases are the assertions in the `#[cfg(test)]` module of Jiff's
 *   `fmt/offset.rs`: the parsed offset as Jiff displays it, and the input left over.
 * - The cases for the other configurations were generated by running Jiff 1.0.0's `strptime`
 *   with `%z`, `%:z`, `%::z` and `%:::z`, which are the four places Jiff uses those
 *   configurations. The error messages are Jiff's with the `strptime parsing failed: %z
 *   failed: ` prefix removed, since that part comes from `strptime` and not from the offset
 *   parser.
 */
@IsTest
private class JiffTemporalOffsetParserTest {
    // `%z`: no Zulu, minutes required, no colons.
    private static final JiffTemporalOffsetParser NO_COLON = new JiffTemporalOffsetParser()
        .zulu(false)
        .requireMinute(true)
        .subminute(true)
        .subsecond(false)
        .colon(JiffTemporalOffsetColon.ABSENT);
    // `%:z`: no Zulu, minutes required, colons required.
    private static final JiffTemporalOffsetParser COLON = new JiffTemporalOffsetParser()
        .zulu(false)
        .requireMinute(true)
        .subminute(true)
        .subsecond(false)
        .colon(JiffTemporalOffsetColon.REQUIRED);
    // `%::z`: as `%:z`, and seconds are required too.
    private static final JiffTemporalOffsetParser COLON_SECONDS = new JiffTemporalOffsetParser()
        .zulu(false)
        .requireMinute(true)
        .requireSecond(true)
        .subminute(true)
        .subsecond(false)
        .colon(JiffTemporalOffsetColon.REQUIRED);
    // `%:::z`: colons required, and only the hours are.
    private static final JiffTemporalOffsetParser COLON_HOURS = new JiffTemporalOffsetParser()
        .zulu(false)
        .requireMinute(false)
        .requireSecond(false)
        .subminute(true)
        .subsecond(false)
        .colon(JiffTemporalOffsetColon.REQUIRED);

    /** Each row is `input => the offset in seconds`. The whole input must be consumed. */
    private static void assertSeconds(JiffTemporalOffsetParser parser, List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            JiffDurationScanner scanner = new JiffDurationScanner(row.substring(0, at));
            JiffTemporalParsedOffset parsed = parser.parse(scanner);
            Assert.areEqual(
                row.substring(at + 4),
                String.valueOf(parsed.toOffset().seconds()),
                row
            );
            Assert.isTrue(scanner.isDone(), row);
        }
    }

    private static void assertErrors(JiffTemporalOffsetParser parser, List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            try {
                JiffTemporalParsedOffset parsed = parser.parse(
                    new JiffDurationScanner(row.substring(0, at))
                );
                Assert.fail('expected an error, but parsed ' + parsed + ': ' + row);
            } catch (JiffException e) {
                Assert.areEqual(row.substring(at + 4), e.getMessage(), row);
            }
        }
    }

    /** Each row is `input => the parsed offset|the input left over`. */
    private static void assertParsedAndRest(JiffTemporalOffsetParser parser, List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            String input = row.substring(0, at);
            JiffDurationScanner scanner = new JiffDurationScanner(input);
            JiffTemporalParsedOffset parsed = parser.parse(scanner);
            Assert.areEqual(
                row.substring(at + 4),
                parsed.toString() + '|' + input.substring(scanner.position()),
                row
            );
        }
    }

    // ---- the default parser -----------------------------------------------

    @IsTest
    static void zuluIsRecognisedInEitherCase() {
        // ok_zulu
        assertParsedAndRest(
            new JiffTemporalOffsetParser(),
            new List<String>{ 'Z => Z|', 'z => Z|' }
        );
        JiffTemporalParsedOffset parsed = new JiffTemporalOffsetParser()
            .parse(new JiffDurationScanner('Z'));
        Assert.isTrue(parsed.isZulu());
    }

    @IsTest
    static void aNumericOffsetParsesToTheEndOfTheInput() {
        // ok_numeric and ok_numeric_complete
        assertParsedAndRest(
            new JiffTemporalOffsetParser(),
            new List<String>{
                '-05 => -05|',
                '+05 => +05|',
                '+25:59 => +25:59|',
                '+2559 => +25:59|',
                '+25:59:59 => +25:59:59|',
                '+255959 => +25:59:59|',
                '+25:59:59.999 => +25:59:59.999|',
                '+25:59:59,999 => +25:59:59.999|',
                '+255959.999 => +25:59:59.999|',
                '+255959,999 => +25:59:59.999|',
                '+25:59:59.999999999 => +25:59:59.999999999|'
            }
        );
    }

    @IsTest
    static void parsingStopsWhereTheOffsetDoes() {
        // ok_numeric_incomplete
        assertParsedAndRest(
            new JiffTemporalOffsetParser(),
            new List<String>{
                '-05a => -05|a',
                '-05:12a => -05:12|a',
                '-05:12. => -05:12|.',
                '-05:12, => -05:12|,',
                '-0512a => -05:12|a',
                '-0512: => -05:12|:',
                '-05:12:34a => -05:12:34|a',
                '-05:12:34.9a => -05:12:34.9|a',
                '-05:12:34.9. => -05:12:34.9|.',
                '-05:12:34.9, => -05:12:34.9|,'
            }
        );
    }

    @IsTest
    static void malformedOffsetsAreRejected() {
        // err_numeric_notsign through err_numeric_fraction_non_empty. The first row is
        // `EndOfInput` from `error/fmt/offset.rs`, which Jiff's own tests do not reach.
        assertErrors(
            new JiffTemporalOffsetParser(),
            new List<String>{
                ' => expected UTC offset, but found end of input',
                '* => failed to parse sign in UTC numeric offset: expected `+` or `-` sign at start of UTC numeric offset',
                '+a => failed to parse hours in UTC numeric offset: expected two digit hour after sign, but found end of input',
                '+ab => failed to parse hours in UTC numeric offset: failed to parse hours (requires a two digit integer): invalid digit, expected 0-9 but got a',
                '-26 => failed to parse hours in UTC numeric offset: failed to parse hours (requires a two digit integer): parameter \'time zone offset hours\' is not in the required range of -25..=25',
                '+05:a => failed to parse minutes in UTC numeric offset: expected two digit minute after hours, but found end of input',
                '+05:ab => failed to parse minutes in UTC numeric offset: failed to parse minutes (requires a two digit integer): invalid digit, expected 0-9 but got a',
                '-05:60 => failed to parse minutes in UTC numeric offset: failed to parse minutes (requires a two digit integer): parameter \'time zone offset minutes\' is not in the required range of -59..=59',
                '+05:30:a => failed to parse seconds in UTC numeric offset: expected two digit second after minutes, but found end of input',
                '+05:30:ab => failed to parse seconds in UTC numeric offset: failed to parse seconds (requires a two digit integer): invalid digit, expected 0-9 but got a',
                '-05:30:60 => failed to parse seconds in UTC numeric offset: failed to parse seconds (requires a two digit integer): parameter \'time zone offset seconds\' is not in the required range of -59..=59',
                '-05:30:44. => failed to parse fractional seconds in UTC numeric offset: found decimal after seconds component, but did not find any digits after decimal',
                '-05:30:44, => failed to parse fractional seconds in UTC numeric offset: found decimal after seconds component, but did not find any digits after decimal',
                '-05:30:44.a => failed to parse fractional seconds in UTC numeric offset: found decimal after seconds component, but did not find any digits after decimal',
                '-05:30:44,a => failed to parse fractional seconds in UTC numeric offset: found decimal after seconds component, but did not find any digits after decimal',
                '-053044.a => failed to parse fractional seconds in UTC numeric offset: found decimal after seconds component, but did not find any digits after decimal',
                '-053044,a => failed to parse fractional seconds in UTC numeric offset: found decimal after seconds component, but did not find any digits after decimal'
            }
        );
    }

    @IsTest
    static void subminutePrecisionCanBeTurnedOff() {
        // err_numeric_subminute_disabled_but_desired
        JiffTemporalOffsetParser minutesOnly = new JiffTemporalOffsetParser().subminute(false);
        assertErrors(
            minutesOnly,
            new List<String>{
                '-05:59:32 => subminute precision for UTC numeric offset is not enabled in this context (must provide only integral minutes)'
            }
        );
        // Without the colon the seconds are simply not part of the offset: Jiff reports
        // `[+053015]` in a time zone annotation, where this configuration is used, as an
        // unexpected `1` after the offset (see `JiffTemporalParserTest`).
        assertParsedAndRest(
            minutesOnly,
            new List<String>{
                '-05:59 => -05:59|',
                '-0559 => -05:59|',
                '-055932 => -05:59|32',
                '-05 => -05|'
            }
        );
    }

    @IsTest
    static void zuluCanBeTurnedOff() {
        // err_zulu_disabled_but_desired
        assertErrors(
            new JiffTemporalOffsetParser().zulu(false),
            new List<String>{
                'Z => found `Z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)',
                'z => found `z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)'
            }
        );
    }

    @IsTest
    static void parseOptionalReturnsNullWhenNoOffsetCanStartHere() {
        JiffTemporalOffsetParser parser = new JiffTemporalOffsetParser();
        for (String input : new List<String>{ '', 'x', '1', '[UTC]', ' +05' }) {
            JiffDurationScanner scanner = new JiffDurationScanner(input);
            Assert.isNull(parser.parseOptional(scanner), input);
            Assert.areEqual(0, scanner.position(), input);
        }
        Assert.areEqual('Z', parser.parseOptional(new JiffDurationScanner('Z')).toString());
        Assert.areEqual('Z', parser.parseOptional(new JiffDurationScanner('z')).toString());
        Assert.areEqual('+05', parser.parseOptional(new JiffDurationScanner('+05')).toString());
        Assert.areEqual(
            '-05:30',
            parser.parseOptional(new JiffDurationScanner('-0530[x]')).toString()
        );
        // Once a sign is seen an offset is required.
        try {
            parser.parseOptional(new JiffDurationScanner('+x'));
            Assert.fail('expected a sign without hours to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'failed to parse hours in UTC numeric offset: ' +
                'expected two digit hour after sign, but found end of input',
                e.getMessage()
            );
        }
    }

    // ---- the configurations behind strptime's %z family ---------------------

    @IsTest
    static void withoutColonsAndWithMinutesRequired() {
        assertSeconds(
            NO_COLON,
            new List<String>{
                '+0530 => 19800',
                '-0530 => -19800',
                '-053015 => -19815',
                '+0000 => 0',
                '-0000 => 0',
                '+2559 => 93540',
                '-255959 => -93599'
            }
        );
        assertErrors(
            NO_COLON,
            new List<String>{
                '+05 => parsed hour component of time zone offset, but could not find required minute component',
                '-05:30 => parsed hour component of time zone offset, but found colon after hours which is not allowed',
                'Z => found `Z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)',
                'z => found `z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)',
                '*0530 => failed to parse sign in UTC numeric offset: expected `+` or `-` sign at start of UTC numeric offset',
                '+053015.5 => subsecond precision for UTC numeric offset is not enabled in this context (must provide only integral minutes or seconds)',
                '+053015,5 => subsecond precision for UTC numeric offset is not enabled in this context (must provide only integral minutes or seconds)',
                '+2600 => failed to parse hours in UTC numeric offset: failed to parse hours (requires a two digit integer): parameter \'time zone offset hours\' is not in the required range of -25..=25',
                '+0560 => failed to parse minutes in UTC numeric offset: failed to parse minutes (requires a two digit integer): parameter \'time zone offset minutes\' is not in the required range of -59..=59',
                '+053060 => failed to parse seconds in UTC numeric offset: failed to parse seconds (requires a two digit integer): parameter \'time zone offset seconds\' is not in the required range of -59..=59',
                '+0 => failed to parse hours in UTC numeric offset: expected two digit hour after sign, but found end of input',
                '+05a0 => parsed hour component of time zone offset, but could not find required minute component',
                '+053 => parsed hour component of time zone offset, but could not find required minute component'
            }
        );
    }

    @IsTest
    static void withColonsAndMinutesRequired() {
        assertSeconds(
            COLON,
            new List<String>{
                '+05:30 => 19800',
                '-05:30 => -19800',
                '-05:30:15 => -19815',
                '+00:00 => 0',
                '+25:59:59 => 93599'
            }
        );
        assertErrors(
            COLON,
            new List<String>{
                '+05 => parsed hour component of time zone offset, but could not find required minute component',
                '+0530 => parsed hour component of time zone offset, but could not find required colon separator',
                '+05: => failed to parse minutes in UTC numeric offset: expected two digit minute after hours, but found end of input',
                '+05:3 => failed to parse minutes in UTC numeric offset: expected two digit minute after hours, but found end of input',
                '+05:30: => failed to parse seconds in UTC numeric offset: expected two digit second after minutes, but found end of input',
                '+05:30:1 => failed to parse seconds in UTC numeric offset: expected two digit second after minutes, but found end of input',
                '+05:30:15.5 => subsecond precision for UTC numeric offset is not enabled in this context (must provide only integral minutes or seconds)',
                'Z => found `Z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)',
                '+05:60 => failed to parse minutes in UTC numeric offset: failed to parse minutes (requires a two digit integer): parameter \'time zone offset minutes\' is not in the required range of -59..=59',
                '+05:30:60 => failed to parse seconds in UTC numeric offset: failed to parse seconds (requires a two digit integer): parameter \'time zone offset seconds\' is not in the required range of -59..=59'
            }
        );
    }

    @IsTest
    static void withColonsAndSecondsRequired() {
        assertSeconds(
            COLON_SECONDS,
            new List<String>{ '+05:30:15 => 19815', '-05:30:15 => -19815', '+00:00:00 => 0' }
        );
        assertErrors(
            COLON_SECONDS,
            new List<String>{
                '+05:30 => parsed hour and minute components of time zone offset, but could not find required second component',
                '+05 => parsed hour component of time zone offset, but could not find required minute component',
                '+0530 => parsed hour component of time zone offset, but could not find required colon separator',
                '+053015 => parsed hour component of time zone offset, but could not find required colon separator',
                '+05:30:15.5 => subsecond precision for UTC numeric offset is not enabled in this context (must provide only integral minutes or seconds)',
                '+05:30:15,5 => subsecond precision for UTC numeric offset is not enabled in this context (must provide only integral minutes or seconds)',
                'z => found `z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)'
            }
        );
    }

    @IsTest
    static void withColonsAndOnlyHoursRequired() {
        assertSeconds(
            COLON_HOURS,
            new List<String>{
                '+05 => 18000',
                '-05 => -18000',
                '+05:30 => 19800',
                '-05:30:15 => -19815'
            }
        );
        assertErrors(
            COLON_HOURS,
            new List<String>{
                '+0530 => parsed hour component of time zone offset, but could not find required colon separator',
                '+05:30:15.5 => subsecond precision for UTC numeric offset is not enabled in this context (must provide only integral minutes or seconds)',
                'Z => found `Z` where a numeric UTC offset was expected (this context does not permit the Zulu offset)',
                '+26 => failed to parse hours in UTC numeric offset: failed to parse hours (requires a two digit integer): parameter \'time zone offset hours\' is not in the required range of -25..=25'
            }
        );
    }

    @IsTest
    static void requiringSecondsHasNoEffectWithoutSubminutePrecision() {
        // "When `subminute` is disabled, this setting has no effect."
        JiffTemporalOffsetParser parser = new JiffTemporalOffsetParser()
            .subminute(false)
            .requireSecond(true);
        assertParsedAndRest(parser, new List<String>{ '+05 => +05|', '+05:30 => +05:30|' });
    }

    // ---- null arguments -----------------------------------------------------

    @IsTest
    static void aNullOptionIsRejectedInsteadOfBeingReadAsAnotherSetting() {
        // A null colon rule used to behave as `ABSENT`, and so reject `+05:30`.
        JiffTemporalOffsetParser parser = new JiffTemporalOffsetParser();
        for (Integer option = 0; option < 6; option++) {
            try {
                if (option == 0) {
                    parser.zulu(null);
                } else if (option == 1) {
                    parser.requireMinute(null);
                } else if (option == 2) {
                    parser.requireSecond(null);
                } else if (option == 3) {
                    parser.subminute(null);
                } else if (option == 4) {
                    parser.subsecond(null);
                } else {
                    parser.colon(null);
                }
                Assert.fail('expected a null value to be rejected for option ' + option);
            } catch (JiffException e) {
                Assert.areEqual(
                    'an option of the UTC offset parser must not be null',
                    e.getMessage(),
                    'option ' + option
                );
            }
        }
        // The parser the options were called on is unchanged, and still takes colons.
        Assert.areEqual('+05:30', parser.parse(new JiffDurationScanner('+05:30')).toString());
    }

    @IsTest
    static void aNullScannerIsRejected() {
        JiffTemporalOffsetParser parser = new JiffTemporalOffsetParser();
        for (Integer attempt = 0; attempt < 2; attempt++) {
            try {
                if (attempt == 0) {
                    parser.parse(null);
                } else {
                    parser.parseOptional(null);
                }
                Assert.fail('expected a null scanner to be rejected, attempt ' + attempt);
            } catch (JiffException e) {
                Assert.areEqual('cannot parse a UTC offset without input', e.getMessage());
            }
        }
    }
}
