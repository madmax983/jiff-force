/**
 * `strftime` formatting of every conversion specifier, flag, width and colon form, and the
 * errors for invalid formats and missing fields.
 *
 * Every row is `value, format, expected`. The value is a date (`D:`), time (`T:`), datetime
 * (`DT:`), timestamp (`TS:`) or zoned datetime (`Z:`) in its `toString()` form, or a broken
 * down time holding only an offset of that many seconds (`O:`). The expected text, or `ERR:`
 * and the error message, is what Jiff 1.0.0 itself produced for the same value and format:
 * the tables were generated by running the real crate (`BrokenDownTime::to_string` and
 * `to_string_with_config`). They include every case of the snapshot tests in Jiff's
 * `fmt::strtime::printer` module. Nothing here was computed by the port.
 *
 * Time zone abbreviations are limited to ones the platform and Jiff agree on (`EST`, `EDT`,
 * `GMT`, `BST`, `UTC`).
 */
@IsTest
private class JiffStrtimeFormatterTest {
    private static final JiffStrtimeConfig STRICT = new JiffStrtimeConfig();
    private static final JiffStrtimeConfig LENIENT = new JiffStrtimeConfig().lenient(true);
    private static final JiffStrtimeConfig POSIX = new JiffStrtimeConfig()
        .custom(new JiffStrtimePosixCustom());
    private static final JiffStrtimeConfig POSIX_LENIENT = POSIX.lenient(true);

    private static JiffBrokenDownTime valueOf(String spec) {
        Integer colon = spec.indexOf(':');
        String kind = spec.substring(0, colon);
        String text = spec.substring(colon + 1);
        if (kind.equals('D')) {
            return JiffBrokenDownTime.fromDate(JiffDate.parse(text));
        }
        if (kind.equals('T')) {
            return JiffBrokenDownTime.fromTime(JiffTime.parse(text));
        }
        if (kind.equals('DT')) {
            return JiffBrokenDownTime.fromDateTime(JiffDateTime.parse(text));
        }
        if (kind.equals('TS')) {
            return JiffBrokenDownTime.fromTimestamp(JiffTimestamp.parse(text));
        }
        if (kind.equals('Z')) {
            return JiffBrokenDownTime.fromZonedDateTime(JiffZonedDateTime.parse(text));
        }
        return new JiffBrokenDownTime().withOffset(JiffOffset.fromSeconds(Integer.valueOf(text)));
    }

    private static String formatted(
        JiffBrokenDownTime tm,
        String format,
        JiffStrtimeConfig config
    ) {
        try {
            return JiffStrtimeFormatter.format(config, format, tm);
        } catch (JiffException e) {
            return 'ERR:' + e.getMessage();
        }
    }

    private static void assertRows(List<List<String>> rows, JiffStrtimeConfig config) {
        List<String> failures = new List<String>();
        for (List<String> row : rows) {
            String actual = formatted(valueOf(row[0]), row[1], config);
            if (!actual.equals(row[2])) {
                failures.add(
                    row[0] + ' ' + row[1] + ': expected [' + row[2] + '] got [' + actual + ']'
                );
            }
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

    private static void assertFormats(List<List<String>> rows) {
        assertRows(rows, STRICT);
    }

    private static void assertFormatsLeniently(List<List<String>> rows) {
        assertRows(rows, LENIENT);
    }

    private static void assertFormatsInPosixLocale(List<List<String>> rows) {
        assertRows(rows, POSIX);
    }

    private static void assertFormatsInLenientPosixLocale(List<List<String>> rows) {
        assertRows(rows, POSIX_LENIENT);
    }

