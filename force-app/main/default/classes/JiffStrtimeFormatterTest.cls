    @IsTest
    static void formattingNeedsAConfigurationAndABrokenDownTime() {
        try {
            JiffStrtimeFormatter.format(null, '%Y', new JiffBrokenDownTime());
            Assert.fail('expected a null configuration to be rejected');
        } catch (JiffException e) {
            Assert.isTrue(e.getMessage().contains('configuration'), e.getMessage());
        }
        try {
            JiffStrtimeFormatter.format(STRICT, '%Y', null);
            Assert.fail('expected a null broken down time to be rejected');
        } catch (JiffException e) {
            Assert.isTrue(e.getMessage().contains('broken down time'), e.getMessage());
        }
        try {
            JiffStrtimeFormatter.format(STRICT, null, new JiffBrokenDownTime());
            Assert.fail('expected a null format to be rejected');
        } catch (JiffException e) {
            Assert.isTrue(e.getMessage().contains('format string'), e.getMessage());
        }
    }
