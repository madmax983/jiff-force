/**
 * Replays timestamp vectors generated by the real Jiff crate (see `oracle/`) against the
 * port. `ERR` in a vector means Jiff reported an error; `JiffOracleSupport` describes how
 * the other values are written.
 */
@IsTest
private class JiffOracleTimestampTest {
    private static final List<String> OPERATIONS = new List<String>{
        'add',
        'subtract',
        'saturatingAdd',
        'saturatingSubtract'
    };

    private static final List<JiffUnit> LARGEST_UNITS = new List<JiffUnit>{
        JiffUnit.HOUR,
        JiffUnit.MINUTE,
        JiffUnit.SECOND,
        JiffUnit.MILLISECOND,
        JiffUnit.MICROSECOND,
        JiffUnit.NANOSECOND
    };

    /** Builds a timestamp with the named constructor; a thrown exception is the caller's. */
    private static JiffTimestamp construct(String constructor, String argument) {
        if (constructor.equals('SECOND')) {
            return JiffTimestamp.fromSecond(Long.valueOf(argument));
        } else if (constructor.equals('MILLISECOND')) {
            return JiffTimestamp.fromMillisecond(Long.valueOf(argument));
        } else if (constructor.equals('MICROSECOND')) {
            return JiffTimestamp.fromMicrosecond(Long.valueOf(argument));
        } else if (constructor.equals('NANOSECOND')) {
            // Jiff takes 128 bits here, and the vectors use all of them.
            return JiffTimestamp.fromNanosecondI128(JiffI128.parse(argument));
        } else if (constructor.equals('PARTS')) {
            List<String> parts = argument.split(',');
            return JiffTimestamp.newInstance(
                Long.valueOf(parts.get(0)),
                Integer.valueOf(parts.get(1))
            );
        }
        Assert.areEqual('DURATION', constructor, 'unknown constructor in a vector');
        return JiffTimestamp.fromDuration(JiffOracleSupport.toDuration(argument));
    }

    @IsTest
    static void constructionAgreesWithJiff() {
        List<String> rows = JiffOracleTimestampData.rows();
        Assert.isTrue(rows.size() >= 340, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimestamp ts;
            try {
                ts = construct(f.get(0), f.get(1));
            } catch (JiffException e) {
                Assert.areEqual(JiffOracleSupport.ERR, f.get(2), 'rejected ' + row);
                continue;
            }
            Assert.areEqual(f.get(2), JiffOracleSupport.timestampText(ts), 'timestamp of ' + row);
            Assert.areEqual(
                f.get(2),
                JiffOracleSupport.durationText(ts.asDuration()),
                'duration since the epoch of ' + row
            );
            Assert.areEqual(Long.valueOf(f.get(3)), ts.asMillisecond(), 'milliseconds of ' + row);
            Assert.areEqual(Long.valueOf(f.get(4)), ts.asMicrosecond(), 'microseconds of ' + row);
            JiffI128 nanoseconds = ts.asNanosecondI128();
            Assert.areEqual(f.get(5), nanoseconds.toString(), 'nanoseconds of ' + row);
            if (nanoseconds.fitsLong()) {
                Assert.areEqual(Long.valueOf(f.get(5)), ts.asNanosecond(), 'nanoseconds of ' + row);
                Assert.areEqual(
                    ts,
                    JiffTimestamp.fromNanosecond(Long.valueOf(f.get(5))),
                    'timestamp from the nanoseconds of ' + row
                );
            }
            Assert.areEqual(f.get(6), ts.toString(), 'text of ' + row);
        }
    }

    /** One of the four ways of adding a span, with `ERR` for a thrown exception. */
    private static String withSpan(String op, JiffTimestamp ts, JiffSpan span) {
        try {
            if (op.equals('add')) {
                return JiffOracleSupport.timestampText(ts.add(span));
            } else if (op.equals('subtract')) {
                return JiffOracleSupport.timestampText(ts.subtract(span));
            } else if (op.equals('saturatingAdd')) {
                return JiffOracleSupport.timestampText(ts.saturatingAdd(span));
            }
            return JiffOracleSupport.timestampText(ts.saturatingSubtract(span));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    /** One of the four ways of adding a duration, with `ERR` for a thrown exception. */
    private static String withDuration(String op, JiffTimestamp ts, JiffSignedDuration duration) {
        try {
            if (op.equals('add')) {
                return JiffOracleSupport.timestampText(ts.add(duration));
            } else if (op.equals('subtract')) {
                return JiffOracleSupport.timestampText(ts.subtract(duration));
            } else if (op.equals('saturatingAdd')) {
                return JiffOracleSupport.timestampText(ts.saturatingAdd(duration));
            }
            return JiffOracleSupport.timestampText(ts.saturatingSubtract(duration));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void addingSpansAgreesWithJiff() {
        List<String> rows = JiffOracleTimestampSpanData.rows();
        Assert.isTrue(rows.size() >= 340, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimestamp ts = JiffOracleSupport.toTimestamp(f.get(0));
            JiffSpan span = JiffOracleSupport.toSpan(f.get(1));
            for (Integer i = 0; i < OPERATIONS.size(); i++) {
                String op = OPERATIONS.get(i);
                Assert.areEqual(f.get(2 + i), withSpan(op, ts, span), op + ' of ' + row);
            }
        }
    }

    @IsTest
    static void addingDurationsAgreesWithJiff() {
        List<String> rows = JiffOracleTimestampDurationData.rows();
        Assert.isTrue(rows.size() >= 320, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimestamp ts = JiffOracleSupport.toTimestamp(f.get(0));
            JiffSignedDuration duration = JiffOracleSupport.toDuration(f.get(1));
            for (Integer i = 0; i < OPERATIONS.size(); i++) {
                String op = OPERATIONS.get(i);
                Assert.areEqual(f.get(2 + i), withDuration(op, ts, duration), op + ' of ' + row);
            }
        }
    }

    /** `a.until(b)` or `a.since(b)` with a largest unit, with `ERR` for a thrown exception. */
    private static String difference(
        Boolean until,
        JiffTimestamp a,
        JiffTimestamp b,
        JiffUnit largest
    ) {
        try {
            return JiffOracleSupport.spanText(until ? a.until(b, largest) : a.since(b, largest));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void differencesAgreeWithJiff() {
        List<String> rows = JiffOracleTimestampDifferenceData.rows();
        Assert.isTrue(rows.size() >= 260, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimestamp a = JiffOracleSupport.toTimestamp(f.get(0));
            JiffTimestamp b = JiffOracleSupport.toTimestamp(f.get(1));
            for (Integer i = 0; i < LARGEST_UNITS.size(); i++) {
                JiffUnit unit = LARGEST_UNITS.get(i);
                Assert.areEqual(
                    f.get(2 + i),
                    difference(true, a, b, unit),
                    'until in ' + unit + ' of ' + row
                );
                Assert.areEqual(
                    f.get(8 + i),
                    difference(false, a, b, unit),
                    'since in ' + unit + ' of ' + row
                );
            }
            // With no unit given, the largest unit is seconds.
            Assert.areEqual(f.get(4), JiffOracleSupport.spanText(a.until(b)), 'until of ' + row);
            Assert.areEqual(f.get(10), JiffOracleSupport.spanText(a.since(b)), 'since of ' + row);
            Assert.areEqual(
                f.get(14),
                JiffOracleSupport.durationText(a.durationUntil(b)),
                'duration until of ' + row
            );
            Assert.areEqual(
                f.get(14),
                JiffOracleSupport.durationText(b.durationSince(a)),
                'duration since of ' + row
            );
            Assert.areEqual(
                f.get(15),
                difference(true, a, b, JiffUnit.DAY),
                'until in days of ' + row
            );
        }
    }

    @IsTest
    static void roundingAgreesWithJiff() {
        List<String> rows = JiffOracleTimestampRoundData.rows();
        Assert.isTrue(rows.size() >= 480, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimestamp ts = JiffOracleSupport.toTimestamp(f.get(0));
            JiffRound options = JiffRound.to(JiffOracleSupport.unit(f.get(1)))
                .increment(Long.valueOf(f.get(2)))
                .mode(JiffOracleSupport.mode(f.get(3)));
            String actual;
            try {
                actual = JiffOracleSupport.timestampText(ts.round(options));
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(4), actual, 'rounding of ' + row);
        }
    }

    @IsTest
    static void printingAgreesWithJiff() {
        List<String> rows = JiffOracleTimestampTextData.rows();
        Assert.isTrue(rows.size() >= 320, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTimestamp ts = JiffOracleSupport.toTimestamp(f.get(0));
            Assert.areEqual(f.get(1), ts.toString(), 'text of ' + row);
            JiffOffset offset = JiffOffset.fromSeconds(Integer.valueOf(f.get(2)));
            Assert.areEqual(f.get(3), ts.toStringWithOffset(offset), 'text with offset of ' + row);
        }
    }
}
