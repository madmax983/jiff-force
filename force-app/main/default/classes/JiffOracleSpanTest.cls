/**
 * Replays span vectors generated by the real Jiff crate (see `oracle/`) against the port:
 * ISO 8601 and friendly printing and parsing, multiplication, and the setters. `ERR` in a
 * vector means Jiff reported an error; `JiffOracleSupport` describes how the other values
 * are written.
 */
@IsTest
private class JiffOracleSpanTest {
    /** Parses with one of the three parsers, with `ERR` for a thrown exception. */
    private static String parse(String parser, String input) {
        try {
            if (parser.equals('iso')) {
                return JiffOracleSupport.spanText(JiffTemporal.parseSpan(input));
            } else if (parser.equals('friendly')) {
                return JiffOracleSupport.spanText(JiffFriendly.parseSpan(input));
            }
            return JiffOracleSupport.spanText(JiffSpan.parse(input));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void isoPrintingAgreesWithJiff() {
        List<String> rows = JiffOracleSpanIsoData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpan span = JiffOracleSupport.toSpan(f.get(0));
            Assert.areEqual(f.get(0), JiffOracleSupport.spanText(span), 'construction of ' + row);
            Assert.areEqual(f.get(1), span.toString(), 'text of ' + row);
            Assert.areEqual(f.get(1), JiffTemporal.printSpan(span, false), 'text of ' + row);
            Assert.areEqual(
                f.get(2),
                JiffTemporal.printSpan(span, true),
                'lower case text of ' + row
            );
            Assert.areEqual(f.get(3), parse('iso', f.get(1)), 'parsing the text of ' + row);
            Assert.areEqual(f.get(3), parse('either', f.get(1)), 'parsing the text of ' + row);
            Assert.areEqual(
                f.get(3),
                parse('iso', f.get(2)),
                'parsing the lower case text of ' + row
            );
        }
    }

    @IsTest
    static void friendlyPrintingAgreesWithJiff() {
        List<String> rows = JiffOracleSpanFriendlyData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpan span = JiffOracleSupport.toSpan(f.get(0));
            Assert.areEqual(f.get(1), span.toFriendly(), 'friendly text of ' + row);
            Assert.areEqual(f.get(1), JiffFriendly.printSpan(span), 'friendly text of ' + row);
            Assert.areEqual(f.get(2), parse('friendly', f.get(1)), 'parsing the text of ' + row);
            Assert.areEqual(f.get(2), parse('either', f.get(1)), 'parsing the text of ' + row);
        }
    }

    @IsTest
    static void configuredFriendlyPrintingAgreesWithJiff() {
        List<String> rows = JiffOracleSpanFriendlyConfigData.rows();
        Assert.isTrue(rows.size() >= 450, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffFriendlyPrinter printer = JiffOracleSupport.toPrinter(f.get(0));
            JiffSpan span = JiffOracleSupport.toSpan(f.get(1));
            Assert.areEqual(f.get(2), printer.spanToString(span), 'friendly text of ' + row);
            Assert.areEqual(
                f.get(2),
                JiffFriendly.printSpan(span, printer),
                'friendly text of ' + row
            );
        }
    }

    /** Checks rows `first` up to but not including `last` of a set of parser inputs. */
    private static void replayParsing(List<String> rows, Integer first, Integer last) {
        for (Integer i = first; i < last; i++) {
            String row = rows.get(i);
            List<String> f = JiffOracleSupport.fields(row);
            String input = JiffOracleSupport.toInput(f.get(0));
            Assert.areEqual(f.get(1), parse('iso', input), 'ISO 8601 parse of ' + row);
            Assert.areEqual(f.get(2), parse('friendly', input), 'friendly parse of ' + row);
            Assert.areEqual(f.get(3), parse('either', input), 'parse of ' + row);
        }
    }

    @IsTest
    static void parsingIsoTextAgreesWithJiff() {
        List<String> rows = JiffOracleSpanParseIsoData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        replayParsing(rows, 0, rows.size());
    }

    @IsTest
    static void parsingFriendlyTextAgreesWithJiff() {
        List<String> rows = JiffOracleSpanParseFriendlyData.rows();
        Assert.isTrue(rows.size() >= 480, 'expected the full vector set');
        replayParsing(rows, 0, 240);
    }

    @IsTest
    static void parsingMoreFriendlyTextAgreesWithJiff() {
        List<String> rows = JiffOracleSpanParseFriendlyData.rows();
        replayParsing(rows, 240, rows.size());
    }

    @IsTest
    static void multiplicationAgreesWithJiff() {
        List<String> rows = JiffOracleSpanMultiplyData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpan span = JiffOracleSupport.toSpan(f.get(0));
            String actual;
            try {
                actual = JiffOracleSupport.spanText(span.multiply(Long.valueOf(f.get(1))));
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(2), actual, 'product of ' + row);
        }
    }

    /**
     * Applies setters written as `y=-1;mo=2` to an empty span and writes the result followed
     * by its signum, or `ERR` when a setter throws. `named` picks the named setters
     * (`years`, `months`, ...) over `withUnit`.
     */
    private static String applySetters(String setters, Boolean named) {
        Map<String, JiffUnit> units = new Map<String, JiffUnit>{
            'y' => JiffUnit.YEAR,
            'mo' => JiffUnit.MONTH,
            'w' => JiffUnit.WEEK,
            'd' => JiffUnit.DAY,
            'h' => JiffUnit.HOUR,
            'm' => JiffUnit.MINUTE,
            's' => JiffUnit.SECOND,
            'ms' => JiffUnit.MILLISECOND,
            'us' => JiffUnit.MICROSECOND,
            'ns' => JiffUnit.NANOSECOND
        };
        JiffSpan span = new JiffSpan();
        try {
            for (String setter : setters.split(';')) {
                List<String> parts = setter.split('=');
                Long value = Long.valueOf(parts.get(1));
                if (named) {
                    span = JiffOracleSupport.setUnit(span, parts.get(0), value);
                } else {
                    span = span.withUnit(units.get(parts.get(0)), value);
                }
            }
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
        return JiffOracleSupport.spanText(span) + '|' + span.signum();
    }

    @IsTest
    static void settersAgreeWithJiff() {
        List<String> rows = JiffOracleSpanSetterData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            String setters = row.substringBefore('|');
            String expected = row.substringAfter('|');
            Assert.areEqual(expected, applySetters(setters, true), 'named setters of ' + row);
            Assert.areEqual(expected, applySetters(setters, false), 'withUnit of ' + row);
            if (!expected.equals(JiffOracleSupport.ERR)) {
                // The sign queries must agree with the signum that was just checked.
                JiffSpan span = JiffOracleSupport.toSpan(expected.substringBefore('|'));
                Integer signum = Integer.valueOf(expected.substringAfter('|'));
                Assert.areEqual(signum, span.signum(), 'signum of ' + row);
                Assert.areEqual(signum > 0, span.isPositive(), 'isPositive of ' + row);
                Assert.areEqual(signum < 0, span.isNegative(), 'isNegative of ' + row);
                Assert.areEqual(signum == 0, span.isZero(), 'isZero of ' + row);
            }
        }
    }
}
