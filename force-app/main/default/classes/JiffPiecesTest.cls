/**
 * `JiffPieces`: parsing a datetime string into its pieces, building pieces by hand, and
 * printing them.
 *
 * The tables are `input => printed | each piece`, generated by running Jiff 1.0.0's
 * `Pieces::parse` and reading back its `Display` output, `date()`, `time()`, `offset()` and
 * `time_zone_annotation()`. The other tests are the examples in the doc comments of
 * `jiff::fmt::temporal::Pieces` and its methods (`fmt/temporal/pieces.rs`), with the same
 * inputs and the same expected values.
 */
@IsTest
private class JiffPiecesTest {
    private static final JiffDate JAN_3 = JiffDate.newInstance(2025, 1, 3);
    private static final JiffDateTime EPOCH_CIVIL = JiffDateTime.newInstance(
        1970,
        1,
        1,
        0,
        0,
        0,
        0
    );

    /** The printed pieces followed by each piece on its own, so nothing can hide. */
    private static String describe(JiffPieces pieces) {
        String offset = 'none';
        if (pieces.offset() != null) {
            JiffPiecesNumericOffset numeric = pieces.offset().asNumeric();
            offset = pieces.offset().isZulu()
                ? 'zulu'
                : 'numeric(' + numeric.offset().seconds() + ',' + numeric.isNegative() + ')';
        }
        String annotation = 'none';
        JiffPiecesTimeZoneAnnotation ann = pieces.timeZoneAnnotation();
        if (ann != null) {
            annotation = ann.kind() == JiffPiecesTimeZoneAnnotationKind.NAMED
                ? 'named(' + ann.name() + ',' + ann.isCritical() + ')'
                : 'offset(' + ann.offset().seconds() + ',' + ann.isCritical() + ')';
        }
        return pieces.toString() +
            ' | date=' +
            pieces.toDate().toString() +
            ' time=' +
            (pieces.toTime() == null ? 'none' : pieces.toTime().toString()) +
            ' offset=' +
            offset +
            ' ann=' +
            annotation;
    }

    // ---- parsing ----------------------------------------------------------

    @IsTest
    static void parsingKeepsEveryPieceAsItWasWritten() {
        List<String> rows = new List<String>{
            '2025-01-03 => 2025-01-03 | date=2025-01-03 time=none offset=none ann=none',
            '20250103 => 2025-01-03 | date=2025-01-03 time=none offset=none ann=none',
            '-000044-03-15 => -000044-03-15 | date=-000044-03-15 time=none offset=none ann=none',
            '2025-01-03T17:28 => 2025-01-03T17:28:00 | date=2025-01-03 time=17:28:00 offset=none ann=none',
            '2025-01-03 17:28:01.5 => 2025-01-03T17:28:01.5 | date=2025-01-03 time=17:28:01.5 offset=none ann=none',
            '2025-01-03T17 => 2025-01-03T17:00:00 | date=2025-01-03 time=17:00:00 offset=none ann=none',
            '2025-01-03T172801 => 2025-01-03T17:28:01 | date=2025-01-03 time=17:28:01 offset=none ann=none',
