            '2025-01-03T17:28Z => 2025-01-03T17:28:00Z | date=2025-01-03 time=17:28:00 offset=zulu ann=none',
            '2025-01-03T17:28z => 2025-01-03T17:28:00Z | date=2025-01-03 time=17:28:00 offset=zulu ann=none',
            '2025-01-03T17:28-05 => 2025-01-03T17:28:00-05:00 | date=2025-01-03 time=17:28:00 offset=numeric(-18000,true) ann=none',
