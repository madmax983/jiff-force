            '2025-01-03T17:28+25:59:59.4 => 2025-01-03T17:28:00+25:59 | date=2025-01-03 time=17:28:00 offset=numeric(93599,false) ann=none',
            '2025-01-03T17:28-25:59:59 => 2025-01-03T17:28:00-25:59 | date=2025-01-03 time=17:28:00 offset=numeric(-93599,true) ann=none',
            '2025-01-03[America/New_York] => 2025-01-03[America/New_York] | date=2025-01-03 time=none offset=none ann=named(America/New_York,false)',
