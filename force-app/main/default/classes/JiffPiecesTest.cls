            '2025-01-03[-05:00] => 2025-01-03[-05:00] | date=2025-01-03 time=none offset=none ann=offset(-18000,false)',
            '2025-01-03[!+0530] => 2025-01-03[!+05:30] | date=2025-01-03 time=none offset=none ann=offset(19800,true)',
            '2025-01-03[+00] => 2025-01-03[+00:00] | date=2025-01-03 time=none offset=none ann=offset(0,false)',
            '2025-01-03[-00:00] => 2025-01-03[+00:00] | date=2025-01-03 time=none offset=none ann=offset(0,false)',
            '2025-01-03T17:28[America/New_York] => 2025-01-03T17:28:00[America/New_York] | date=2025-01-03 time=17:28:00 offset=none ann=named(America/New_York,false)',
            '2025-01-03T17:28-05[America/New_York] => 2025-01-03T17:28:00-05:00[America/New_York] | date=2025-01-03 time=17:28:00 offset=numeric(-18000,true) ann=named(America/New_York,false)',
            '2025-01-03T17:28-05:00[-05:00] => 2025-01-03T17:28:00-05:00[-05:00] | date=2025-01-03 time=17:28:00 offset=numeric(-18000,true) ann=offset(-18000,false)',
            '2025-01-03T17:28+02[-07:00] => 2025-01-03T17:28:00+02:00[-07:00] | date=2025-01-03 time=17:28:00 offset=numeric(7200,false) ann=offset(-25200,false)',
            '2025-01-03T17:28Z[Australia/Bluey] => 2025-01-03T17:28:00Z[Australia/Bluey] | date=2025-01-03 time=17:28:00 offset=zulu ann=named(Australia/Bluey,false)',
            '2025-01-03T17:28-00:00[!+00:00][u-ca=gregory] => 2025-01-03T17:28:00-00:00[!+00:00] | date=2025-01-03 time=17:28:00 offset=numeric(0,true) ann=offset(0,true)',
            '2015-10-18[America/Sao_Paulo] => 2015-10-18[America/Sao_Paulo] | date=2015-10-18 time=none offset=none ann=named(America/Sao_Paulo,false)'
        };
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            Assert.areEqual(
                row.substring(at + 4),
                describe(JiffPieces.parse(row.substring(0, at))),
                row
            );
        }
    }

    @IsTest
    static void stringsThatAreNotDatetimesAreRejected() {
        List<String> rows = new List<String>{
            ' => expected four digit year (or leading sign for six digit year), but found end of input',
            '2025-01 => failed to parse separator after month: expected `-` separator, but found end of input',
            '2025-01-03T => expected two digit hour, but found end of input',
            '2025-01-03T17:28+25:59:59.5 => due to precision loss from fractional seconds, time zone offset is rounded to a value that is out of bounds',
            '2025-01-03T17:28-25:59:59.5 => due to precision loss from fractional seconds, time zone offset is rounded to a value that is out of bounds',
            '2025-01-03T17:28+26 => failed to parse hours in UTC numeric offset: failed to parse hours (requires a two digit integer): parameter \'time zone offset hours\' is not in the required range of -25..=25',
            '2025-01-03Z => parsed value \'2025-01-03\', but unparsed input "Z" remains (expected no unparsed input)',
            '2025-01-03-05:00 => parsed value \'2025-01-03\', but unparsed input "-05:00" remains (expected no unparsed input)',
            '2025-01-03T17:28-05 [America/New_York] => parsed value \'2025-01-03T17:28:00-05\', but unparsed input " [America/New_York]" remains (expected no unparsed input)',
            '2025-01-03T17:28[America/New_York]x => parsed value \'2025-01-03T17:28:00[America/New_York]\', but unparsed input "x" remains (expected no unparsed input)',
            '2025-01-03T17:28[!u-ca=gregory] => found unsupported RFC 9557 annotation with the critical flag (`!`) set',
            '2025-01-03T17:28[+05:30:15] => subminute precision for UTC numeric offset is not enabled in this context (must provide only integral minutes)',
            '17:28 => failed to parse four digit integer as year: invalid digit, expected 0-9 but got :'
        };
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            try {
                JiffPieces.parse(row.substring(0, at));
                Assert.fail('expected a parse error: ' + row);
            } catch (JiffException e) {
                Assert.areEqual(row.substring(at + 4), e.getMessage(), row);
            }
        }
    }

    @IsTest
    static void parseReturnsTheDateTimeAndZoneOfAnAnnotatedString() {
        // The example on `Pieces::parse`.
        JiffPieces pieces = JiffPieces.parse('2025-01-03T16:42[America/Whitehorse]');
        Assert.areEqual(JAN_3, pieces.toDate());
        Assert.areEqual(JiffTime.newInstance(16, 42, 0, 0), pieces.toTime());
        Assert.isNull(pieces.toNumericOffset());
        Assert.areEqual(JiffTimeZone.get('America/Whitehorse'), pieces.toTimeZone());
    }

    @IsTest
    static void theDateIsAlwaysPresentAndTheTimeIsOptional() {
        // The examples on `Pieces::date` and `Pieces::time`.
        Assert.areEqual(JAN_3, JiffPieces.parse('2025-01-03').toDate());
        JiffPieces pieces = JiffPieces.parse('2025-01-03T14:49:01');
        Assert.areEqual(JAN_3, pieces.toDate());
        Assert.areEqual(JiffTime.newInstance(14, 49, 1, 0), pieces.toTime());
        // Parsing into pieces just gives the component parts, so no time.
        Assert.isNull(JiffPieces.parse('2015-10-18[America/Sao_Paulo]').toTime());
    }

    @IsTest
    static void theThreeWaysOfWritingAZeroOffsetAreToldApart() {
        // The example on `Pieces::offset`, repeated on `Pieces` itself.
        JiffPiecesOffset zulu = JiffPieces.parse('1970-01-01T00:00:00Z').offset();
        Assert.areEqual(JiffPiecesOffset.ZULU, zulu);
        Assert.areEqual(JiffOffset.UTC, zulu.toNumericOffset());

        JiffPiecesOffset negativeZero = JiffPieces.parse('1970-01-01T00:00:00-00:00').offset();
        Assert.areEqual(
            JiffPiecesOffset.fromNumeric(
                JiffPiecesNumericOffset.fromOffset(JiffOffset.UTC).withNegativeZero()
            ),
            negativeZero
        );
        Assert.areEqual(JiffOffset.UTC, negativeZero.toNumericOffset());

        JiffPiecesOffset positiveZero = JiffPieces.parse('1970-01-01T00:00:00+00:00').offset();
        Assert.areEqual(
            JiffPiecesOffset.fromNumeric(JiffPiecesNumericOffset.fromOffset(JiffOffset.UTC)),
            positiveZero
        );
        Assert.areEqual(JiffOffset.UTC, positiveZero.toNumericOffset());
        Assert.areNotEqual(negativeZero, positiveZero);
        Assert.areNotEqual(zulu, negativeZero);
    }

    @IsTest
    static void toNumericOffsetCollapsesEveryZeroOffsetToUtc() {
        // The example on `Pieces::to_numeric_offset`.
        for (
            String text : new List<String>{
                '1970-01-01T00:00:00Z',
                '1970-01-01T00:00:00-00:00',
                '1970-01-01T00:00:00+00:00'
            }
        ) {
            Assert.areEqual(JiffOffset.UTC, JiffPieces.parse(text).toNumericOffset(), text);
        }
    }

    @IsTest
    static void theAnnotationIsANameOrAnOffset() {
        // The example on `Pieces::time_zone_annotation`.
        Assert.areEqual(
            JiffPiecesTimeZoneAnnotation.fromName('America/New_York'),
            JiffPieces.parse('2025-01-02T16:47-05[America/New_York]').timeZoneAnnotation()
        );
        Assert.areEqual(
            JiffPiecesTimeZoneAnnotation.fromOffset(JiffOffset.fromHours(-5)),
            JiffPieces.parse('2025-01-02T16:47-05[-05:00]').timeZoneAnnotation()
        );
        Assert.isNull(JiffPieces.parse('2025-01-02T16:47-05').timeZoneAnnotation());
    }

    @IsTest
    static void toTimeZoneLooksUpTheAnnotation() {
        // The example on `Pieces::to_time_zone`.
        // No time zone annotation means null.
        Assert.isNull(JiffPieces.parse('2025-01-03T17:13-05').toTimeZone());
        // An offset annotation gives a fixed offset time zone.
        Assert.areEqual(
            JiffTimeZone.fixed(JiffOffset.fromHours(-5)),
            JiffPieces.parse('2025-01-03T17:13-05[-05]').toTimeZone()
        );
        // A name gives an IANA time zone.
        Assert.areEqual(
            JiffTimeZone.get('America/New_York'),
            JiffPieces.parse('2025-01-03T17:13-05[America/New_York]').toTimeZone()
        );
        // A name that does not exist is an error, but only once it is looked up.
        JiffPieces bluey = JiffPieces.parse('2025-01-03T17:13-05[Australia/Bluey]');
        try {
            bluey.toTimeZone();
            Assert.fail('expected an unknown time zone to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'failed to find time zone `Australia/Bluey` in time zone database',
                e.getMessage()
            );
        }
    }

    // ---- building ---------------------------------------------------------

    @IsTest
    static void piecesAreBuiltFromADateADatetimeOrATimestamp() {
        // The examples on `Pieces::with_date` and `Pieces::with_time`.
        Assert.areEqual('2025-01-03', JiffPieces.fromDate(JAN_3).toString());
        JiffPieces fromTimestamp = JiffPieces.fromTimestamp(JiffTimestamp.fromSecond(1735930208L));
        Assert.areEqual(JAN_3, fromTimestamp.toDate());
        Assert.areEqual('2025-01-03T18:50:08Z', fromTimestamp.toString());

        Assert.areEqual(
            '2025-01-03T13:48:00',
            JiffPieces.fromDate(JAN_3).withTime(JiffTime.newInstance(13, 48, 0, 0)).toString()
        );
        Assert.areEqual(
            '2025-01-03T13:48:00',
            JiffPieces.fromDateTime(JiffDateTime.newInstance(2025, 1, 3, 13, 48, 0, 0)).toString()
        );
        Assert.areEqual(
            '2024-12-25T13:48:00',
            JiffPieces.fromDateTime(JiffDateTime.newInstance(2025, 1, 3, 13, 48, 0, 0))
                .withDate(JiffDate.newInstance(2024, 12, 25))
                .toString()
        );
    }

    @IsTest
    static void settingAnOffsetDoesNotChangeAnyOtherPiece() {
        // The examples on `Pieces::with_offset`.
        JiffPieces pieces = JiffPieces.parse('2025-01-03T07:55+02[+02]')
            .withOffset(JiffOffset.fromHours(-10));
        // This is nonsense because the offsets don't match, and that is allowed.
        Assert.areEqual('2025-01-03T07:55:00-10:00[+02:00]', pieces.toString());

        // Changing the offset of a timestamp's pieces changes the instant they describe.
        Assert.areEqual(
            '1970-01-01T00:00:00-05:00',
            JiffPieces.fromTimestamp(JiffTimestamp.UNIX_EPOCH)
                .withOffset(JiffOffset.fromHours(-5))
                .toString()
        );
        // Which is why there is a conversion from a timestamp and an offset together.
        Assert.areEqual(
            '1969-12-31T19:00:00-05:00',
            JiffPieces.fromTimestampWithOffset(JiffTimestamp.UNIX_EPOCH, JiffOffset.fromHours(-5))
                .toString()
        );
    }

    @IsTest
    static void anOffsetForcesATimeToBeWritten() {
        // The examples on `Pieces::with_offset`, "setting an offset forces a time to be
        // written".
        Assert.areEqual('2025-01-03', JiffPieces.fromDate(JAN_3).toString());
        Assert.areEqual(
            '2025-01-03[Africa/Cairo]',
            JiffPieces.fromDate(JAN_3).withTimeZoneName('Africa/Cairo').toString()
        );
        Assert.areEqual(
            '2025-01-03T00:00:00-05:00',
            JiffPieces.fromDate(JAN_3).withOffset(JiffOffset.fromHours(-5)).toString()
        );
        Assert.areEqual(
            '2025-01-03T00:00:00+02:00[Africa/Cairo]',
            JiffPieces.fromDate(JAN_3)
                .withOffset(JiffOffset.fromHours(2))
                .withTimeZoneName('Africa/Cairo')
                .toString()
        );
    }

    @IsTest
    static void aZuluOrNegativeZeroOffsetCanBePrinted() {
        // The examples on `Pieces::with_offset`, "formatting a Zulu or -00:00 offset", and on
        // `PiecesNumericOffset::with_negative_zero`.
        JiffPieces epoch = JiffPieces.fromDateTime(EPOCH_CIVIL);
        Assert.areEqual('1970-01-01T00:00:00+00:00', epoch.withOffset(JiffOffset.UTC).toString());
        Assert.areEqual('1970-01-01T00:00:00Z', epoch.withOffset(JiffPiecesOffset.ZULU).toString());
        JiffPiecesOffset negativeZero = JiffPiecesOffset.fromNumeric(
            JiffPiecesNumericOffset.fromOffset(JiffOffset.UTC).withNegativeZero()
        );
        Assert.areEqual('1970-01-01T00:00:00-00:00', epoch.withOffset(negativeZero).toString());

        // A timestamp and a UTC offset: "the offset from UTC is known and is zero".
        Assert.areEqual(
            '1970-01-01T00:00:00+00:00',
            JiffPieces.fromTimestampWithOffset(JiffTimestamp.UNIX_EPOCH, JiffOffset.UTC).toString()
        );
        // A timestamp alone: "the offset from UTC is not known".
        Assert.areEqual(
            '1970-01-01T00:00:00Z',
            JiffPieces.fromTimestamp(JiffTimestamp.UNIX_EPOCH).toString()
        );
        Assert.areEqual(
            '1970-01-01T00:00:00-00:00',
            JiffPieces.fromTimestamp(JiffTimestamp.UNIX_EPOCH).withOffset(negativeZero).toString()
        );
    }

    @IsTest
    static void theAnnotationIsReplacedWithoutBeingChecked() {
        // The examples on `Pieces::with_time_zone_name`, `with_time_zone_offset` and
        // `with_time_zone_annotation`.
        JiffPieces pieces = JiffPieces.parse('2025-01-03T07:55+02[Africa/Cairo]');
        // `Australia/Bluey` is not a time zone.
        Assert.areEqual(
            '2025-01-03T07:55:00+02:00[Australia/Bluey]',
            pieces.withTimeZoneName('Australia/Bluey').toString()
        );
        // The offset `+02` does not match `-07`.
        Assert.areEqual(
            '2025-01-03T07:55:00+02:00[-07:00]',
            pieces.withTimeZoneOffset(JiffOffset.fromHours(-7)).toString()
        );
        // The offset `+02` is never valid for `Canada/Yukon`.
        Assert.areEqual(
            '2025-01-03T07:55:00+02:00[Canada/Yukon]',
            pieces.withTimeZoneAnnotation(JiffPiecesTimeZoneAnnotation.fromName('Canada/Yukon'))
                .toString()
        );
    }

    @IsTest
    static void changedPiecesPrintAndParseBack() {
        // The example at the top of `Pieces`.
        JiffPieces pieces = JiffPieces.parse('2025-01-03T07:55+02[Africa/Cairo]')
            .withOffset(JiffOffset.fromHours(-10));
        Assert.areEqual('2025-01-03T07:55:00-10:00[Africa/Cairo]', pieces.toString());

        JiffPieces again = JiffPieces.parse('2025-01-03T07:55:00-10:00[Africa/Cairo]');
        Assert.areEqual(JAN_3, again.toDate());
        Assert.areEqual(JiffTime.newInstance(7, 55, 0, 0), again.toTime());
        Assert.areEqual(JiffOffset.fromHours(-10), again.toNumericOffset());
        Assert.areEqual(JiffTimeZone.get('Africa/Cairo'), again.toTimeZone());
        Assert.areEqual(pieces, again);
    }

    @IsTest
    static void aTimestampWithoutAZoneCanBeReadThroughItsPieces() {
        // The case study on `Pieces`: `2025-01-03T17:28-05` has no time zone annotation, so
        // it cannot become a zoned datetime directly, but its pieces give everything needed
        // to choose a fixed offset zone.
        JiffPieces pieces = JiffPieces.parse('2025-01-03T17:28-05');
        Assert.areEqual(JAN_3, pieces.toDate());
        Assert.areEqual(JiffTime.newInstance(17, 28, 0, 0), pieces.toTime());
        Assert.areEqual(JiffOffset.fromHours(-5), pieces.toNumericOffset());
        Assert.isNull(pieces.toTimeZone());
        Assert.areEqual(
            JiffTimestamp.parse('2025-01-03T22:28:00Z'),
            JiffTimeZone.fixed(pieces.toNumericOffset())
                .toTimestamp(JiffDateTime.fromParts(pieces.toDate(), pieces.toTime()))
        );
    }

    @IsTest
    static void aPieceIsRemovedBySettingItToNull() {
        JiffPieces full = JiffPieces.parse('2025-01-03T07:55+02[Africa/Cairo]');
        JiffPiecesOffset noOffset = null;
        Assert.areEqual('2025-01-03T07:55:00[Africa/Cairo]', full.withOffset(noOffset).toString());
        Assert.areEqual('2025-01-03T00:00:00+02:00[Africa/Cairo]', full.withTime(null).toString());
        Assert.areEqual('2025-01-03T07:55:00+02:00', full.withTimeZoneAnnotation(null).toString());
        Assert.areEqual(
            JiffPieces.fromDate(JAN_3),
            full.withOffset(noOffset).withTime(null).withTimeZoneAnnotation(null)
        );
    }

    @IsTest
    static void theDateAndTheSourceValuesAreRequired() {
        JiffPieces pieces = JiffPieces.fromDate(JAN_3);
        JiffDate noDate = null;
        JiffDateTime noDateTime = null;
        JiffTimestamp noTimestamp = null;
        for (Integer attempt = 0; attempt < 6; attempt++) {
            try {
                if (attempt == 0) {
                    JiffPieces.fromDate(noDate);
                } else if (attempt == 1) {
                    JiffPieces.fromDateTime(noDateTime);
                } else if (attempt == 2) {
                    JiffPieces.fromTimestamp(noTimestamp);
                } else if (attempt == 3) {
                    JiffPieces.fromTimestampWithOffset(noTimestamp, JiffOffset.UTC);
                } else if (attempt == 4) {
                    JiffPieces.fromTimestampWithOffset(JiffTimestamp.UNIX_EPOCH, null);
                } else {
                    pieces.withDate(noDate);
                }
                Assert.fail('expected a missing value to be rejected, attempt ' + attempt);
            } catch (JiffException e) {
                Assert.isTrue(e.getMessage().startsWith('datetime pieces need'), e.getMessage());
            }
        }
    }

    // ---- equality ---------------------------------------------------------

    @IsTest
    static void piecesAreEqualWhenEveryPieceIs() {
        JiffPieces a = JiffPieces.parse('2025-01-03T07:55-00:00[!Africa/Cairo]');
        JiffPieces b = JiffPieces.parse('20250103T0755-00[!Africa/Cairo]');
        Assert.areEqual(a, b);
        Assert.areEqual(a.hashCode(), b.hashCode());
        Assert.isTrue(a.equals(b));

        List<String> others = new List<String>{
            '2025-01-04T07:55-00:00[!Africa/Cairo]',
            '2025-01-03T07:56-00:00[!Africa/Cairo]',
            '2025-01-03-00:00[!Africa/Cairo]',
            '2025-01-03T07:55+00:00[!Africa/Cairo]',
            '2025-01-03T07:55Z[!Africa/Cairo]',
            '2025-01-03T07:55[!Africa/Cairo]',
            '2025-01-03T07:55-00:00[Africa/Cairo]',
            '2025-01-03T07:55-00:00[!Africa/Tunis]',
            '2025-01-03T07:55-00:00[!+02:00]',
            '2025-01-03T07:55-00:00'
        };
        for (String other : others) {
            // `2025-01-03-00:00` is not valid text, so that one is built instead of parsed.
            JiffPieces different = other.equals('2025-01-03-00:00[!Africa/Cairo]')
                ? a.withTime(null)
                : JiffPieces.parse(other);
            Assert.isFalse(a.equals(different), other);
            Assert.isFalse(different.equals(a), other);
        }
        Assert.isFalse(a.equals('2025-01-03T07:55:00-00:00[!Africa/Cairo]'));
        Assert.isFalse(a.equals(null));
        // A piece that is absent on both sides counts as equal.
        Assert.areEqual(JiffPieces.fromDate(JAN_3), JiffPieces.parse('2025-01-03'));
        Assert.areEqual(
            JiffPieces.fromDate(JAN_3).hashCode(),
            JiffPieces.parse('2025-01-03').hashCode()
        );
    }
