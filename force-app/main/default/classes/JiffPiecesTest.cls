            '2025-01-03T17:28-00 => 2025-01-03T17:28:00-00:00 | date=2025-01-03 time=17:28:00 offset=numeric(0,true) ann=none',
            '2025-01-03T17:28-0000 => 2025-01-03T17:28:00-00:00 | date=2025-01-03 time=17:28:00 offset=numeric(0,true) ann=none',
