/**
 * Replays civil time vectors generated by the real Jiff crate (see `oracle/`) against the
 * port. `ERR` in a vector means Jiff reported an error; `JiffOracleSupport` describes how
 * the other values are written.
 */
@IsTest
private class JiffOracleTimeTest {
    private static final List<String> OPERATIONS = new List<String>{
        'add',
        'subtract',
        'wrappingAdd',
        'wrappingSubtract',
        'saturatingAdd',
        'saturatingSubtract'
    };

    /** One of the six ways of adding a span, as text, with `ERR` for a thrown exception. */
    private static String withSpan(String op, JiffTime t, JiffSpan span) {
        try {
            if (op.equals('add')) {
                return t.add(span).toString();
            } else if (op.equals('subtract')) {
                return t.subtract(span).toString();
            } else if (op.equals('wrappingAdd')) {
                return t.wrappingAdd(span).toString();
            } else if (op.equals('wrappingSubtract')) {
                return t.wrappingSubtract(span).toString();
            } else if (op.equals('saturatingAdd')) {
                return t.saturatingAdd(span).toString();
            }
            return t.saturatingSubtract(span).toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    /** One of the six ways of adding a duration, as text, with `ERR` for a thrown exception. */
    private static String withDuration(String op, JiffTime t, JiffSignedDuration duration) {
        try {
            if (op.equals('add')) {
                return t.add(duration).toString();
            } else if (op.equals('subtract')) {
                return t.subtract(duration).toString();
            } else if (op.equals('wrappingAdd')) {
                return t.wrappingAdd(duration).toString();
            } else if (op.equals('wrappingSubtract')) {
                return t.wrappingSubtract(duration).toString();
            } else if (op.equals('saturatingAdd')) {
                return t.saturatingAdd(duration).toString();
            }
            return t.saturatingSubtract(duration).toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void addingSpansAgreesWithJiff() {
        List<String> rows = JiffOracleTimeSpanData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTime t = JiffOracleSupport.toTime(f.get(0));
            Assert.areEqual(f.get(0), t.toString(), 'text of ' + row);
            JiffSpan span = JiffOracleSupport.toSpan(f.get(1));
            for (Integer i = 0; i < OPERATIONS.size(); i++) {
                String op = OPERATIONS.get(i);
                Assert.areEqual(f.get(2 + i), withSpan(op, t, span), op + ' of ' + row);
            }
        }
    }

    @IsTest
    static void addingDurationsAgreesWithJiff() {
        List<String> rows = JiffOracleTimeDurationData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTime t = JiffOracleSupport.toTime(f.get(0));
            JiffSignedDuration duration = JiffOracleSupport.toDuration(f.get(1));
            for (Integer i = 0; i < OPERATIONS.size(); i++) {
                String op = OPERATIONS.get(i);
                Assert.areEqual(f.get(2 + i), withDuration(op, t, duration), op + ' of ' + row);
            }
        }
    }

    /** `a.until(b)` or `a.since(b)` with a largest unit, with `ERR` for a thrown exception. */
    private static String difference(Boolean until, JiffTime a, JiffTime b, JiffUnit largest) {
        try {
            return JiffOracleSupport.spanText(until ? a.until(b, largest) : a.since(b, largest));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void differencesAgreeWithJiff() {
        List<JiffUnit> largest = new List<JiffUnit>{
            JiffUnit.HOUR,
            JiffUnit.MINUTE,
            JiffUnit.SECOND,
            JiffUnit.MILLISECOND,
            JiffUnit.MICROSECOND,
            JiffUnit.NANOSECOND
        };
        List<String> rows = JiffOracleTimeDifferenceData.rows();
        Assert.isTrue(rows.size() >= 250, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTime a = JiffOracleSupport.toTime(f.get(0));
            JiffTime b = JiffOracleSupport.toTime(f.get(1));
            for (Integer i = 0; i < largest.size(); i++) {
                JiffUnit unit = largest.get(i);
                Assert.areEqual(
                    f.get(2 + i),
                    difference(true, a, b, unit),
                    'until in ' + unit + ' of ' + row
                );
                Assert.areEqual(
                    f.get(8 + i),
                    difference(false, a, b, unit),
                    'since in ' + unit + ' of ' + row
                );
            }
            // With no unit given, the largest unit is hours.
            Assert.areEqual(f.get(2), JiffOracleSupport.spanText(a.until(b)), 'until of ' + row);
            Assert.areEqual(f.get(8), JiffOracleSupport.spanText(a.since(b)), 'since of ' + row);
            Assert.areEqual(
                f.get(14),
                JiffOracleSupport.durationText(a.durationUntil(b)),
                'duration until of ' + row
            );
            Assert.areEqual(
                f.get(14),
                JiffOracleSupport.durationText(b.durationSince(a)),
                'duration since of ' + row
            );
            Assert.areEqual(
                f.get(15),
                difference(true, a, b, JiffUnit.DAY),
                'until in days of ' + row
            );
        }
    }

    @IsTest
    static void roundingAgreesWithJiff() {
        List<String> rows = JiffOracleTimeRoundData.rows();
        Assert.isTrue(rows.size() >= 450, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTime t = JiffOracleSupport.toTime(f.get(0));
            JiffRound options = JiffRound.to(JiffOracleSupport.unit(f.get(1)))
                .increment(Long.valueOf(f.get(2)))
                .mode(JiffOracleSupport.mode(f.get(3)));
            String actual;
            try {
                actual = t.round(options).toString();
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(4), actual, 'rounding of ' + row);
        }
    }

    /** Applies setters written as `hour=3;subsecNanosecond=5` and builds. */
    private static String build(JiffTime t, String setters) {
        JiffTimeWith builder = t.with();
        if (!setters.equals('none')) {
            for (String setter : setters.split(';')) {
                List<String> parts = setter.split('=');
                String name = parts.get(0);
                Integer value = Integer.valueOf(parts.get(1));
                if (name.equals('hour')) {
                    builder = builder.hour(value);
                } else if (name.equals('minute')) {
                    builder = builder.minute(value);
                } else if (name.equals('second')) {
                    builder = builder.second(value);
                } else if (name.equals('millisecond')) {
                    builder = builder.millisecond(value);
                } else if (name.equals('microsecond')) {
                    builder = builder.microsecond(value);
                } else if (name.equals('nanosecond')) {
                    builder = builder.nanosecond(value);
                } else {
                    Assert.areEqual('subsecNanosecond', name, 'unknown setter in a vector');
                    builder = builder.subsecNanosecond(value);
                }
            }
        }
        try {
            return builder.build().toString();
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void withBuilderAgreesWithJiff() {
        List<String> rows = JiffOracleTimeWithData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffTime t = JiffOracleSupport.toTime(f.get(0));
            Assert.areEqual(f.get(2), build(t, f.get(1)), 'building ' + row);
        }
    }
}
