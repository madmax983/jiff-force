/**
 * Replays signed duration vectors generated by the real Jiff crate (see `oracle/`) against the
 * port: arithmetic, rounding, and ISO 8601 and friendly printing and parsing. A duration is
 * written as `seconds,nanoseconds`, and `ERR` in a vector means Jiff reported an overflow, an
 * invalid operation or text it could not parse.
 */
@IsTest
private class JiffOracleDurationTest {
    private static final Map<String, JiffUnit> UNITS = new Map<String, JiffUnit>{
        'NANOSECOND' => JiffUnit.NANOSECOND,
        'MICROSECOND' => JiffUnit.MICROSECOND,
        'MILLISECOND' => JiffUnit.MILLISECOND,
        'SECOND' => JiffUnit.SECOND,
        'MINUTE' => JiffUnit.MINUTE,
        'HOUR' => JiffUnit.HOUR
    };

    private static final Map<String, JiffRoundMode> MODES = new Map<String, JiffRoundMode>{
        'CEIL' => JiffRoundMode.CEIL,
        'FLOOR' => JiffRoundMode.FLOOR,
        'EXPAND' => JiffRoundMode.EXPAND,
        'TRUNC' => JiffRoundMode.TRUNC,
        'HALF_CEIL' => JiffRoundMode.HALF_CEIL,
        'HALF_FLOOR' => JiffRoundMode.HALF_FLOOR,
        'HALF_EXPAND' => JiffRoundMode.HALF_EXPAND,
        'HALF_TRUNC' => JiffRoundMode.HALF_TRUNC,
        'HALF_EVEN' => JiffRoundMode.HALF_EVEN
    };

    private static JiffSignedDuration parse(String text) {
        List<String> parts = text.split(',');
        return JiffSignedDuration.newInstance(
            Long.valueOf(parts.get(0)),
            Integer.valueOf(parts.get(1))
        );
    }

    /** Formats a result the way the vectors do, with `ERR` standing for a thrown exception. */
    private static String show(JiffSignedDuration value) {
        return value.asSecs() + ',' + value.subsecNanos();
    }

    private static String attempt(
        String op,
        JiffSignedDuration a,
        JiffSignedDuration b,
        Integer n
    ) {
        try {
            if (op.equals('add')) {
                return show(a.add(b));
            } else if (op.equals('subtract')) {
                return show(a.subtract(b));
            } else if (op.equals('multiply')) {
                return show(a.multiply(n));
            }
            return show(a.divide(n));
        } catch (JiffException e) {
            return 'ERR';
        }
    }

    @IsTest
    static void arithmeticAgreesWithJiff() {
        List<String> rows = JiffOracleDurationData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = row.split('\\|');
            JiffSignedDuration a = parse(f.get(0));
            JiffSignedDuration b = parse(f.get(1));
            Assert.areEqual(f.get(0), show(a), 'construction of ' + row);
            Assert.areEqual(f.get(2), attempt('add', a, b, 0), 'sum of ' + row);
            Assert.areEqual(f.get(3), attempt('subtract', a, b, 0), 'difference of ' + row);
            Assert.areEqual(
                f.get(5),
                attempt('multiply', a, b, Integer.valueOf(f.get(4))),
                'product of ' + row
            );
            Assert.areEqual(
                f.get(7),
                attempt('divide', a, b, Integer.valueOf(f.get(6))),
                'quotient of ' + row
            );
            Assert.areEqual(Integer.valueOf(f.get(8)), a.compareTo(b), 'ordering of ' + row);
            Assert.areEqual(f.get(9), a.toString(), 'text of ' + row);
        }
    }

    @IsTest
    static void roundingAgreesWithJiff() {
        List<String> rows = JiffOracleDurationRoundData.rows();
        Assert.isTrue(rows.size() >= 1020, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = row.split('\\|');
            JiffSignedDuration duration = parse(f.get(0));
            JiffRound options = JiffRound.to(UNITS.get(f.get(1)))
                .increment(Long.valueOf(f.get(2)))
                .mode(MODES.get(f.get(3)));
            String actual;
            try {
                actual = show(duration.round(options));
            } catch (JiffException e) {
                actual = 'ERR';
            }
            Assert.areEqual(f.get(4), actual, 'rounding of ' + row);
        }
    }

    /** Parses with one of the three parsers, with `ERR` for a thrown exception. */
    private static String parseWith(String parser, String input) {
        try {
            if (parser.equals('iso')) {
                return show(JiffTemporal.parseDuration(input));
            } else if (parser.equals('friendly')) {
                return show(JiffFriendly.parseDuration(input));
            }
            return show(JiffSignedDuration.parse(input));
        } catch (JiffException e) {
            return 'ERR';
        }
    }

    @IsTest
    static void printingAgreesWithJiff() {
        List<String> rows = JiffOracleDurationTextData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = row.split('\\|');
            JiffSignedDuration duration = parse(f.get(0));
            Assert.areEqual(f.get(1), duration.toString(), 'ISO 8601 text of ' + row);
            Assert.areEqual(
                f.get(1),
                JiffTemporal.printDuration(duration, false),
                'ISO 8601 text of ' + row
            );
            Assert.areEqual(
                f.get(2),
                JiffTemporal.printDuration(duration, true),
                'lower case ISO 8601 text of ' + row
            );
            Assert.areEqual(f.get(3), duration.toFriendly(), 'friendly text of ' + row);
            Assert.areEqual(
                f.get(3),
                JiffFriendly.printDuration(duration),
                'friendly text of ' + row
            );
            Assert.areEqual(f.get(4), parseWith('iso', f.get(1)), 'parsing the ISO text of ' + row);
            Assert.areEqual(
                f.get(4),
                parseWith('either', f.get(1)),
                'parsing the ISO text of ' + row
            );
            Assert.areEqual(
                f.get(4),
                parseWith('iso', f.get(2)),
                'parsing the lower case ISO text of ' + row
            );
            Assert.areEqual(
                f.get(5),
                parseWith('friendly', f.get(3)),
                'parsing the friendly text of ' + row
            );
            Assert.areEqual(
                f.get(5),
                parseWith('either', f.get(3)),
                'parsing the friendly text of ' + row
            );
        }
    }

    @IsTest
    static void configuredFriendlyPrintingAgreesWithJiff() {
        List<String> rows = JiffOracleDurationFriendlyConfigData.rows();
        Assert.isTrue(rows.size() >= 450, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = row.split('\\|');
            JiffFriendlyPrinter printer = JiffOracleSupport.toPrinter(f.get(0));
            JiffSignedDuration duration = parse(f.get(1));
            Assert.areEqual(
                f.get(2),
                printer.durationToString(duration),
                'friendly text of ' + row
            );
            Assert.areEqual(
                f.get(2),
                JiffFriendly.printDuration(duration, printer),
                'friendly text of ' + row
            );
        }
    }

    /** Checks rows `first` up to but not including `last` of a set of parser inputs. */
    private static void replayParsing(List<String> rows, Integer first, Integer last) {
        for (Integer i = first; i < last; i++) {
            String row = rows.get(i);
            List<String> f = row.split('\\|');
            String input = JiffOracleSupport.toInput(f.get(0));
            Assert.areEqual(f.get(1), parseWith('iso', input), 'ISO 8601 parse of ' + row);
            Assert.areEqual(f.get(2), parseWith('friendly', input), 'friendly parse of ' + row);
            Assert.areEqual(f.get(3), parseWith('either', input), 'parse of ' + row);
        }
    }

    @IsTest
    static void parsingIsoTextAgreesWithJiff() {
        List<String> rows = JiffOracleDurationParseIsoData.rows();
        Assert.isTrue(rows.size() >= 300, 'expected the full vector set');
        replayParsing(rows, 0, rows.size());
    }

    @IsTest
    static void parsingFriendlyTextAgreesWithJiff() {
        List<String> rows = JiffOracleDurationParseFriendlyData.rows();
        Assert.isTrue(rows.size() >= 500, 'expected the full vector set');
        replayParsing(rows, 0, 250);
    }

    @IsTest
    static void parsingMoreFriendlyTextAgreesWithJiff() {
        List<String> rows = JiffOracleDurationParseFriendlyData.rows();
        replayParsing(rows, 250, rows.size());
    }
}
