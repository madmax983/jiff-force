/**
 * Parsing of dates, times, datetimes, timestamps, ISO week dates, time zones and RFC 9557
 * annotations.
 *
 * Every row is `input => expected`, and every expected value is what Jiff 1.0.0 itself
 * produces for that input: the tables were generated by running the real crate
 * (`DateTimeParser::parse_date`, `parse_datetime`, `parse_timestamp`, `parse_time`,
 * `parse_time_zone`, `Pieces::parse` and `ISOWeekDate::from_str`) and printing the parsed value
 * or the error message. Nothing here was computed by the port.
 *
 * A few tests cover inputs where the port differs from Jiff on purpose, and say so: POSIX time
 * zone strings, which the port does not have, and instants just below the smallest timestamp,
 * which Jiff lets through. Their expected error is the one Jiff gives for the nearest input
 * that it rejects itself.
 */
@IsTest
private class JiffTemporalParserTest {
    private static String parse(String kind, String input) {
        if (kind.equals('date')) {
            return JiffTemporal.parseDate(input).toString();
        }
        if (kind.equals('datetime')) {
            return JiffTemporal.parseDateTime(input).toString();
        }
        if (kind.equals('timestamp')) {
            return JiffTemporal.parseTimestamp(input).toString();
        }
        if (kind.equals('time')) {
            return JiffTemporal.parseTime(input).toString();
        }
        if (kind.equals('week')) {
            return JiffTemporal.parseIsoWeekDate(input).toString();
        }
        if (kind.equals('zone')) {
            return JiffTemporal.printTimeZone(JiffTemporal.parseTimeZone(input));
        }
        return describe(JiffTemporal.parsePieces(input));
    }

    /** The printed pieces followed by each piece on its own, so nothing can hide. */
    private static String describe(JiffPieces pieces) {
        String offset = 'none';
        if (pieces.offset() != null) {
            JiffPiecesNumericOffset numeric = pieces.offset().asNumeric();
            offset = pieces.offset().isZulu()
                ? 'zulu'
                : 'numeric(' + numeric.offset().seconds() + ',' + numeric.isNegative() + ')';
        }
        String annotation = 'none';
        JiffPiecesTimeZoneAnnotation ann = pieces.timeZoneAnnotation();
        if (ann != null) {
            annotation = ann.kind() == JiffPiecesTimeZoneAnnotationKind.NAMED
                ? 'named(' + ann.name() + ',' + ann.isCritical() + ')'
                : 'offset(' + ann.offset().seconds() + ',' + ann.isCritical() + ')';
        }
        return pieces.toString() +
            ' | date=' +
            pieces.toDate().toString() +
            ' time=' +
            (pieces.toTime() == null ? 'none' : pieces.toTime().toString()) +
            ' offset=' +
            offset +
            ' ann=' +
            annotation;
    }

    private static void assertParses(String kind, List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            Assert.areEqual(row.substring(at + 4), parse(kind, row.substring(0, at)), row);
        }
    }

    private static void assertErrors(String kind, List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            try {
                String parsed = parse(kind, row.substring(0, at));
                Assert.fail('expected an error, but parsed ' + parsed + ': ' + row);
            } catch (JiffException e) {
                Assert.areEqual(row.substring(at + 4), e.getMessage(), row);
            }
        }
    }

    // ---- dates ------------------------------------------------------------

    @IsTest
    static void datesParseAndEverythingAfterTheDateIsIgnored() {
        assertParses(
            'date',
            new List<String>{
                '2024-06-19 => 2024-06-19',
                '20240619 => 2024-06-19',
                '0000-01-01 => 0000-01-01',
                '9999-12-31 => 9999-12-31',
                '+002024-06-19 => 2024-06-19',
                '+000000-01-01 => 0000-01-01',
                '-000044-03-15 => -000044-03-15',
                '-009999-01-01 => -009999-01-01',
                '+009999-12-31 => 9999-12-31',
                '-0099990101 => -009999-01-01',
                '2024-02-29 => 2024-02-29',
                '2024-06-19T15:22:45 => 2024-06-19',
                '2024-06-19t15:22:45 => 2024-06-19',
                '2024-06-19 15:22:45 => 2024-06-19',
                '2024-06-19T15 => 2024-06-19',
                '2024-06-19T1522 => 2024-06-19',
                '20240619T152245.5 => 2024-06-19',
                '2024-06-19T15:22:60 => 2024-06-19',
                '2024-06-19T15:22:45-04:00 => 2024-06-19',
                '2024-06-19T15:22:45-00:00 => 2024-06-19',
                '2024-06-19T15:22:45+25:59:59.4 => 2024-06-19',
                '2024-06-19T15:22:45-04:00[America/New_York] => 2024-06-19',
                '2024-06-19[America/New_York] => 2024-06-19',
                '2024-06-19[!America/New_York] => 2024-06-19',
                '2024-06-19[-04:00] => 2024-06-19',
                '2024-06-19[u-ca=gregory] => 2024-06-19',
                '2024-06-19[America/New_York][u-ca=gregory] => 2024-06-19',
                '2024-06-19[America/New_York][u-ca=gregory][foo=bar-baz-1] => 2024-06-19',
                '2024-06-19T15:22:45[Not/A_Zone] => 2024-06-19'
            }
        );
    }

