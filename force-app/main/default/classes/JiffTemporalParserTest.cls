    @IsTest
    static void posixTimeZoneStringsAreLookedUpAsNamesAndSoFail() {
        // Jiff parses this as a POSIX time zone. The port has none (see `JiffTimeZone`), so
        // the string falls through to the name lookup. The wording is Jiff's for a name that
        // is not in the database.
        try {
            JiffTemporal.parseTimeZone('EST5EDT,M3.2.0,M11.1.0');
            Assert.fail('expected a POSIX time zone string to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'parsed apparent IANA time zone identifier, but the tzdb lookup failed: ' +
                'failed to find time zone `EST5EDT,M3.2.0,M11.1.0` in time zone database',
                e.getMessage()
            );
        }
    }

