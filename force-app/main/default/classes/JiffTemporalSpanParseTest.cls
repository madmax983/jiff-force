/**
 * ISO 8601 duration parsing, and printing with lowercase designators.
 *
 * The cases are the snapshot assertions for `SpanParser` in the `#[cfg(test)]` module of
 * Jiff's `fmt/temporal/parser.rs`, the examples in the doc comments of `fmt/temporal/mod.rs`,
 * and vectors generated by running Jiff 1.0.0 where its own tests do not reach. A row is
 * `input => expected`.
 */
@IsTest
private class JiffTemporalSpanParseTest {
    /** Each row is `input => the span in the friendly format`, which is how Jiff debugs one. */
    private static void assertSpans(List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            JiffSpan span = JiffTemporal.parseSpan(row.substring(0, at));
            Assert.areEqual(row.substring(at + 4), JiffFriendly.printSpan(span), row);
        }
    }

    private static void assertSpanErrors(List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            try {
                JiffTemporal.parseSpan(row.substring(0, at));
                Assert.fail('expected a span parse error: ' + row);
            } catch (JiffException e) {
                Assert.areEqual(row.substring(at + 4), e.getMessage(), row);
            }
        }
    }

    /** Jiff's alternate debug form of a signed duration: `60s 1ns`, `-500000000ns`, `75s`. */
    private static String debug(JiffSignedDuration duration) {
        if (duration.subsecNanos() == 0) {
            return duration.asSecs() + 's';
        }
        if (duration.asSecs() == 0) {
            return duration.subsecNanos() + 'ns';
        }
        return duration.asSecs() + 's ' + Math.abs(duration.subsecNanos()) + 'ns';
    }

    /** Each row is `input => the duration in Jiff's debug form`. */
    private static void assertDurations(List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            JiffSignedDuration duration = JiffTemporal.parseDuration(row.substring(0, at));
            Assert.areEqual(row.substring(at + 4), debug(duration), row);
        }
    }

    private static void assertDurationErrors(List<String> rows) {
        for (String row : rows) {
            Integer at = row.indexOf(' => ');
            try {
                JiffTemporal.parseDuration(row.substring(0, at));
                Assert.fail('expected a duration parse error: ' + row);
            } catch (JiffException e) {
                Assert.areEqual(row.substring(at + 4), e.getMessage(), row);
            }
        }
    }

    // ---- spans ------------------------------------------------------------

    @IsTest
    static void spansParseWithUpperOrLowerCaseDesignators() {
        assertSpans(
            new List<String>{
                'P5d => 5d',
                '-P5d => 5d ago',
                '+P5d => 5d',
                'P5DT1s => 5d 1s',
                'PT1S => 1s',
                'PT0S => 0s',
                'P0Y => 0s',
                'P1Y1M1W1DT1H1M1S => 1y 1mo 1w 1d 1h 1m 1s',
                'P1y1m1w1dT1h1m1s => 1y 1mo 1w 1d 1h 1m 1s',
                'p1y2m3w4dt5h6m7s => 1y 2mo 3w 4d 5h 6m 7s',
                'P3y7m25dT7h36m => 3y 7mo 25d 7h 36m',
                'PT48m => 48m',
                'P1W1D => 1w 1d',
                'P1M1W => 1mo 1w',
                'P1YT1S => 1y 1s'
            }
        );
        Assert.areEqual(
            new JiffSpan().years(3).months(7).days(25).hours(7).minutes(36),
            JiffTemporal.parseSpan('P3y7m25dT7h36m')
        );
        Assert.areEqual(new JiffSpan().minutes(48), JiffTemporal.parseSpan('PT48m'));
    }

    @IsTest
    static void unitsAreKeptAsWrittenAndZeroHasNoSign() {
        assertSpans(
            new List<String>{
                'PT90M => 90m',
                '-P0D => 0s',
                'P0Y0M0W0DT0H0M0S => 0s',
                'PT0.0S => 0s',
                '-PT0.0S => 0s'
            }
        );
        Assert.isTrue(JiffTemporal.parseSpan('-P0D').isZero());
    }

    @IsTest
    static void aFractionIsCarriedIntoTheSmallerUnits() {
        assertSpans(
            new List<String>{
                'PT0.5h => 30m',
                'PT0.123456789h => 7m 24s 444ms 440µs 400ns',
                'PT1.123456789h => 1h 7m 24s 444ms 440µs 400ns',
                'PT0.5m => 30s',
                'PT0.123456789m => 7s 407ms 407µs 340ns',
                'PT1.123456789m => 1m 7s 407ms 407µs 340ns',
                'PT0.5s => 500ms',
                '-PT0.5s => 500ms ago',
                '-PT0.000000001s => 1ns ago',
                'PT0.123456789s => 123ms 456µs 789ns',
                'PT1.123456789s => 1s 123ms 456µs 789ns',
                'PT1,5S => 1s 500ms',
                'PT1,5M => 1m 30s',
                'PT1H1.5M => 1h 1m 30s',
                'PT1H1M1.5S => 1h 1m 1s 500ms',
                'P1DT1.5H => 1d 1h 30m',
                'P1Y2M3W4DT5H6M7.5S => 1y 2mo 3w 4d 5h 6m 7s 500ms'
            }
        );
    }

    @IsTest
    static void secondsBeyondTheLimitOfASpanSpillIntoSubsecondUnits() {
        assertSpans(
            new List<String>{
                'PT1902545624836.854775807s => ' +
                '631107417600s 631107417600000ms 631107417600000000µs 9223372036854775807ns',
                'PT175307616h10518456960m640330789636.854775807s => ' +
                '175307616h 10518456960m 631107417600s 9223372036854ms 775µs 807ns',
                '-PT1902545624836.854775807s => ' +
                '631107417600s 631107417600000ms 631107417600000000µs 9223372036854775807ns ago',
                '-PT175307616h10518456960m640330789636.854775807s => ' +
                '175307616h 10518456960m 631107417600s 9223372036854ms 775µs 807ns ago'
            }
        );
    }

    @IsTest
    static void timeUnitsBeyondTheirLimitsProduceAnUnbalancedSpan() {
        assertSpans(
            new List<String>{
                'PT175307616h10518456960m1774446656760s => ' +
                '175307616h 10518456960m 631107417600s 631107417600000ms 512231821560000000µs',
                'Pt843517082H => ' +
                '175307616h 10518456960m 631107417600s 631107417600000ms 512231824800000000µs',
                'Pt843517081H => ' +
                '175307616h 10518456960m 631107417600s 631107417600000ms 512231821200000000µs',
                // The excess from a unit over its limit is combined with the smaller units
                // that were also written, rather than one replacing the other.
                'PT175307617h1m => 175307616h 61m',
                '-PT175307617h1m => 175307616h 61m ago',
                'PT175307617h1.5m => 175307616h 61m 30s',
                'PT10518456961m1s => 10518456960m 61s'
            }
        );
    }

    @IsTest
    static void aSpanTooLongForItsUnitsSurvivesARoundTrip() {
        JiffSpan first = JiffTemporal.parseSpan('Pt843517081,1H');
        Assert.areEqual(
            '175307616h 10518456960m 631107417600s 631107417600000ms 512231821560000000µs',
            JiffFriendly.printSpan(first)
        );
        Assert.areEqual('PT175307616H10518456960M1774446656760S', first.toString());
        JiffSpan second = JiffTemporal.parseSpan(first.toString());
        Assert.areEqual(first.toInvariantDuration(), second.toInvariantDuration());
    }

    @IsTest
    static void spansRejectTextThatIsNotADuration() {
        assertSpanErrors(
            new List<String>{
                ' => expected to find duration beginning with `P` or `p`, but found end of input',
                '- => expected to find duration beginning with `P` or `p`, but found end of input',
                '+ => expected to find duration beginning with `P` or `p`, but found end of input',
                'X => expected to find duration beginning with `P` or `p`, but found `X` instead',
                ' P1D => expected to find duration beginning with `P` or `p`, ' +
                'but found ` ` instead',
                'P => no parsed duration components',
                'P-1D => no parsed duration components',
                'PT => found a time designator (`T` or `t`) in an ISO 8601 duration string, ' +
                'but did not find any time units',
                'P1DT => found a time designator (`T` or `t`) in an ISO 8601 duration string, ' +
                'but did not find any time units',
                'PTT1S => found a time designator (`T` or `t`) in an ISO 8601 duration string, ' +
                'but did not find any time units',
                'P1Yx => parsed value \'P1Y\', but unparsed input "x" remains ' +
                '(expected no unparsed input)',
                'P1D  => parsed value \'P1D\', but unparsed input " " remains ' +
                '(expected no unparsed input)'
            }
        );
    }

    @IsTest
    static void spansRejectMissingAndMisplacedDesignators() {
        assertSpanErrors(
            new List<String>{
                'P1 => expected to find date unit designator suffix (`Y`, `M`, `W` or `D`), ' +
                'but found end of input',
                'P1H => expected to find date unit designator suffix (`Y`, `M`, `W` or `D`), ' +
                'but found `H` instead',
                'P1.5D => expected to find date unit designator suffix (`Y`, `M`, `W` or `D`), ' +
                'but found `.` instead',
                'P1\t => expected to find date unit designator suffix (`Y`, `M`, `W` or `D`), ' +
                'but found `\\t` instead',
                'P1" => expected to find date unit designator suffix (`Y`, `M`, `W` or `D`), ' +
                'but found `\\"` instead',
                'P1€ => expected to find date unit designator suffix (`Y`, `M`, `W` or `D`), ' +
                'but found `\\xE2` instead',
                'P1DT1 => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found end of input',
                'PT1.5 => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found end of input',
                'PT1\' => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found `\\\'` instead',
                'PT1µ => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found `\\xC2` instead',
                // Only nine fractional digits are read.
                'PT0.1234567891S => expected to find time unit designator suffix ' +
                '(`H`, `M` or `S`), but found `1` instead',
                'PT1. => found decimal after seconds component, ' +
                'but did not find any digits after decimal'
            }
        );
    }

    @IsTest
    static void spansRejectUnitsOutOfOrderOrRepeated() {
        assertSpanErrors(
            new List<String>{
                'P1D1Y => found value with unit year after unit day, ' +
                'but units must be written from largest to smallest ' +
                '(and they can\'t be repeated)',
                'P1Y1Y => found value with unit year after unit year, ' +
                'but units must be written from largest to smallest ' +
                '(and they can\'t be repeated)',
                'PT1M1H => found value with unit hour after unit minute, ' +
                'but units must be written from largest to smallest ' +
                '(and they can\'t be repeated)',
                // Nothing may follow a unit that has a fraction.
                'PT1.5H1M => parsed value \'PT1H30M\', but unparsed input "1M" remains ' +
                '(expected no unparsed input)'
            }
        );
    }

    @IsTest
    static void spansRejectValuesBeyondTheirLimits() {
        assertSpanErrors(
            new List<String>{
                'P19999Y => failed to set value for year unit on span: ' +
                'parameter \'years\' is not in the required range of -19998..=19998',
                'P239977M => failed to set value for month unit on span: ' +
                'parameter \'months\' is not in the required range of -239976..=239976',
                'P1043498W => failed to set value for week unit on span: ' +
                'parameter \'weeks\' is not in the required range of -1043497..=1043497',
                'P7304485D => failed to set value for day unit on span: ' +
                'parameter \'days\' is not in the required range of -7304484..=7304484',
                'PT9223372036854775808S => value for seconds is too big (or small) ' +
                'to fit into a signed 64-bit integer',
                '-PT9223372036854775808S => failed to set value for second unit on span: ' +
                'failed to set nanosecond value from fractional component',
                'PT18446744073709551616S => number too big to parse into 64-bit integer',
                'PT9223372036854775807H => failed to set value for hour unit on span: ' +
                'converting hours to seconds overflows a signed 64-bit integer',
                'PT9223372036854775807M => failed to set value for minute unit on span: ' +
                'converting minutes to seconds overflows a signed 64-bit integer'
            }
        );
    }

    // ---- signed durations -------------------------------------------------

    @IsTest
    static void durationsParseFromTheTimePart() {
        assertDurations(
            new List<String>{
                'PT0s => 0s',
                'PT0.000000001s => 1ns',
                '-PT0.000000001s => -1ns',
                '-PT0.5s => -500000000ns',
                'PT1s => 1s',
                'PT59s => 59s',
                'PT60s => 60s',
                'PT1m => 60s',
                'PT1m0.000000001s => 60s 1ns',
                'PT1.25m => 75s',
                'PT1h => 3600s',
                'PT1h0.000000001s => 3600s 1ns',
                'PT1.25h => 4500s',
                'PT48m => 2880s',
                'PT2H30M => 9000s',
                'PT2.5h => 9000s',
                'PT1.5m => 90s',
                'PT0.0021s => 2100000ns',
                '+PT1S => 1s',
                'pt1h2m3s => 3723s',
                'PT1H2M3.5S => 3723s 500000000ns',
                '-PT1H2M3,5S => -3723s 500000000ns',
                '-PT0S => 0s',
                'PT24H2M5.123000789S => 86525s 123000789ns'
            }
        );
        Assert.areEqual(JiffSignedDuration.fromMins(48L), JiffTemporal.parseDuration('PT48m'));
    }

    @IsTest
    static void durationsCoverTheWholeRangeOfASignedDuration() {
        assertDurations(
            new List<String>{
                '-PT2562047788015215h30m8.999999999s => -9223372036854775808s 999999999ns',
                'PT2562047788015215h30m7.999999999s => 9223372036854775807s 999999999ns',
                'PT9223372036854775807S => 9223372036854775807s',
                '-PT9223372036854775808S => -9223372036854775808s'
            }
        );
        Assert.areEqual(
            JiffSignedDuration.MIN,
            JiffTemporal.parseDuration('-PT2562047788015215h30m8.999999999s')
        );
        Assert.areEqual(
            JiffSignedDuration.MAX,
            JiffTemporal.parseDuration('PT2562047788015215h30m7.999999999s')
        );
    }

    @IsTest
    static void durationsRejectCalendarUnitsAndAMissingTimePart() {
        String needsTime =
            'parsing ISO 8601 duration in this context requires that the duration ' +
            'contain a time component and no components of days or greater';
        assertDurationErrors(
            new List<String>{
                'P0d => ' + needsTime,
                'P1d => ' + needsTime,
                'P0dT1s => ' + needsTime,
                'P => ' + needsTime,
                'PT0d => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found `d` instead',
                'PT1Y => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found `Y` instead',
                'PT1 => expected to find time unit designator suffix (`H`, `M` or `S`), ' +
                'but found end of input',
                ' => expected to find duration beginning with `P` or `p`, but found end of input',
                'X => expected to find duration beginning with `P` or `p`, but found `X` instead',
                'PT => found a time designator (`T` or `t`) in an ISO 8601 duration string, ' +
                'but did not find any time units',
                'PTs => found a time designator (`T` or `t`) in an ISO 8601 duration string, ' +
                'but did not find any time units',
                'PT1.S => found decimal after seconds component, ' +
                'but did not find any digits after decimal',
                'PT1S  => parsed value \'PT1S\', but unparsed input " " remains ' +
                '(expected no unparsed input)',
                'PT1.5H1M => parsed value \'PT1H30M\', but unparsed input "1M" remains ' +
                '(expected no unparsed input)'
            }
        );
    }

    @IsTest
    static void durationsRejectUnitsOutOfOrder() {
        assertDurationErrors(
            new List<String>{
                'PT1s1m => found value with unit minute after unit second, ' +
                'but units must be written from largest to smallest ' +
                '(and they can\'t be repeated)',
                'PT1s1h => found value with unit hour after unit second, ' +
                'but units must be written from largest to smallest ' +
                '(and they can\'t be repeated)',
                'PT1m1h => found value with unit hour after unit minute, ' +
                'but units must be written from largest to smallest ' +
                '(and they can\'t be repeated)'
            }
        );
    }

    @IsTest
    static void durationsRejectTotalsThatOverflow() {
        assertDurationErrors(
            new List<String>{
                '-PT9223372036854775809s => value for seconds is too big (or small) ' +
                'to fit into a signed 64-bit integer',
                'PT9223372036854775808s => value for seconds is too big (or small) ' +
                'to fit into a signed 64-bit integer',
                'PT1m9223372036854775807s => accumulated duration overflowed ' +
                'when adding value to unit second',
                'PT2562047788015215.6h => accumulated duration overflowed ' +
                'when adding fractional value to unit hour',
                'PT2562047788015216H => accumulated duration overflowed ' +
                'when adding value to unit hour',
                'PT153722867280912931M => accumulated duration overflowed ' +
                'when adding value to unit minute',
                'PT9223372036854775807M => accumulated duration overflowed ' +
                'when adding value to unit minute'
            }
        );
    }

    @IsTest
    static void nullTextIsRejected() {
        try {
            JiffTemporal.parseSpan(null);
            Assert.fail('expected null to be rejected');
        } catch (JiffException e) {
            Assert.areEqual('cannot parse a duration from a null string', e.getMessage());
        }
        try {
            JiffTemporal.parseDuration(null);
            Assert.fail('expected null to be rejected');
        } catch (JiffException e) {
            Assert.areEqual('cannot parse a duration from a null string', e.getMessage());
        }
    }

    // ---- lowercase printing -------------------------------------------------

    @IsTest
    static void spansPrintWithLowercaseDesignatorsOnRequest() {
        JiffSpan span = new JiffSpan().years(5).days(10).hours(1);
        Assert.areEqual('P5Y10DT1H', JiffTemporal.printSpan(span, false));
        Assert.areEqual('P5y10dT1h', JiffTemporal.printSpan(span, true));
        JiffSpan everyUnit = new JiffSpan()
            .years(1)
            .months(2)
            .weeks(3)
            .days(4)
            .hours(5)
            .minutes(6)
            .seconds(7)
            .milliseconds(500)
            .negate();
        Assert.areEqual('-P1y2m3w4dT5h6m7.5s', JiffTemporal.printSpan(everyUnit, true));
        Assert.areEqual('-P1Y2M3W4DT5H6M7.5S', JiffTemporal.printSpan(everyUnit, false));
        Assert.areEqual('PT0s', JiffTemporal.printSpan(new JiffSpan(), true));
        Assert.areEqual('P1w', JiffTemporal.printSpan(new JiffSpan().weeks(1), true));
        // What is printed in lowercase parses back to the same span.
        Assert.areEqual(everyUnit, JiffTemporal.parseSpan(JiffTemporal.printSpan(everyUnit, true)));
    }

    @IsTest
    static void durationsPrintWithLowercaseDesignatorsOnRequest() {
        JiffSignedDuration duration = JiffSignedDuration.newInstance(86525L, 123000789);
        Assert.areEqual('PT24H2M5.123000789S', JiffTemporal.printDuration(duration, false));
        Assert.areEqual('PT24h2m5.123000789s', JiffTemporal.printDuration(duration, true));
        Assert.areEqual(
            '-PT1h30m',
            JiffTemporal.printDuration(JiffSignedDuration.fromSecs(-5400L), true)
        );
        Assert.areEqual('PT0s', JiffTemporal.printDuration(JiffSignedDuration.ZERO, true));
        Assert.areEqual(
            '-PT2562047788015215h30m8.999999999s',
            JiffTemporal.printDuration(JiffSignedDuration.MIN, true)
        );
        Assert.areEqual(
            duration,
            JiffTemporal.parseDuration(JiffTemporal.printDuration(duration, true))
        );
    }
}
