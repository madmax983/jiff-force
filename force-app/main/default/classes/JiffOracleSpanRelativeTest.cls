/**
 * Replays vectors generated by the real Jiff crate (see `oracle/`) for the span operations that
 * depend on a relative reference: rounding, totals, comparison and arithmetic, and the rounded
 * `until` and `since` of each datetime type.
 */
@IsTest
private class JiffOracleSpanRelativeTest {
    private static final Map<String, JiffTimeZone> ZONES = new Map<String, JiffTimeZone>();

    private static JiffTimeZone zone(String name) {
        if (!ZONES.containsKey(name)) {
            ZONES.put(name, JiffTimeZone.get(name));
        }
        return ZONES.get(name);
    }

    /** Reads `-`, `24h`, `D:<date>`, `DT:<datetime>` or `Z:<zone>:<secs,nanos>`. */
    private static JiffSpanRelativeTo relative(String text) {
        if (text.equals('-')) {
            return null;
        }
        if (text.equals('24h')) {
            return JiffSpanRelativeTo.daysAre24Hours();
        }
        if (text.startsWith('DT:')) {
            return JiffSpanRelativeTo.fromDateTime(JiffOracleSupport.toDateTime(text.substring(3)));
        }
        if (text.startsWith('D:')) {
            return JiffSpanRelativeTo.fromDate(JiffOracleSupport.toDate(text.substring(2)));
        }
        Integer instantAt = text.indexOf(':', 2);
        return JiffSpanRelativeTo.fromZonedDateTime(
            JiffOracleSupport.toTimestamp(text.substring(instantAt + 1))
                .toZonedDateTime(zone(text.substring(2, instantAt)))
        );
    }

    private static JiffUnit optionalUnit(String text) {
        return text.equals('-') ? null : JiffOracleSupport.unit(text);
    }

    @IsTest
    static void roundingAgreesWithJiff() {
        List<String> rows = JiffOracleSpanRoundData.rows();
        Assert.isTrue(rows.size() >= 500, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpanRound options = JiffSpanRound.to(JiffOracleSupport.unit(f.get(2)))
                .largest(optionalUnit(f.get(3)))
                .increment(Long.valueOf(f.get(4)))
                .mode(JiffOracleSupport.mode(f.get(5)));
            JiffSpanRelativeTo rel = relative(f.get(1));
            if (rel != null) {
                options = options.relative(rel);
            }
            String actual;
            try {
                actual = JiffOracleSupport.spanText(
                    JiffOracleSupport.toSpan(f.get(0)).round(options)
                );
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(6), actual, 'rounding of ' + row);
        }
    }

    @IsTest
    static void totalsAgreeWithJiff() {
        List<String> rows = JiffOracleSpanTotalData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpan span = JiffOracleSupport.toSpan(f.get(0));
            JiffSpanRelativeTo rel = relative(f.get(1));
            JiffUnit unit = JiffOracleSupport.unit(f.get(2));
            String expected = f.get(3);
            try {
                Double total = rel == null ? span.total(unit) : span.total(unit, rel);
                Assert.areNotEqual(JiffOracleSupport.ERR, expected, 'expected an error for ' + row);
                Assert.areEqual(Double.valueOf(expected), total, 'total of ' + row);
            } catch (JiffException e) {
                Assert.areEqual(
                    JiffOracleSupport.ERR,
                    expected,
                    'unexpected error for ' + row + ': ' + e.getMessage()
                );
            }
        }
    }

    @IsTest
    static void comparisonsAgreeWithJiff() {
        List<String> rows = JiffOracleSpanCompareData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpan a = JiffOracleSupport.toSpan(f.get(0));
            JiffSpan b = JiffOracleSupport.toSpan(f.get(1));
            JiffSpanRelativeTo rel = relative(f.get(2));
            String actual;
            try {
                actual = String.valueOf(rel == null ? a.compare(b) : a.compare(b, rel));
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(3), actual, 'comparison of ' + row);
        }
    }

    private static String arithmetic(
        Boolean adding,
        JiffSpan a,
        JiffSpan b,
        JiffSpanRelativeTo rel
    ) {
        try {
            JiffSpan result;
            if (adding) {
                result = rel == null ? a.add(b) : a.add(b, rel);
            } else {
                result = rel == null ? a.subtract(b) : a.subtract(b, rel);
            }
            return JiffOracleSupport.spanText(result);
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void arithmeticAgreesWithJiff() {
        List<String> rows = JiffOracleSpanArithmeticData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffSpan a = JiffOracleSupport.toSpan(f.get(0));
            JiffSpan b = JiffOracleSupport.toSpan(f.get(1));
            JiffSpanRelativeTo rel = relative(f.get(2));
            Assert.areEqual(f.get(3), arithmetic(true, a, b, rel), 'sum of ' + row);
            Assert.areEqual(f.get(4), arithmetic(false, a, b, rel), 'difference of ' + row);
        }
    }

    private static String difference(
        Boolean until,
        String kind,
        String a,
        String b,
        JiffDifference options
    ) {
        try {
            JiffSpan result;
            if (kind.equals('D')) {
                JiffDate x = JiffOracleSupport.toDate(a);
                JiffDate y = JiffOracleSupport.toDate(b);
                result = until ? x.until(y, options) : x.since(y, options);
            } else if (kind.equals('DT')) {
                JiffDateTime x = JiffOracleSupport.toDateTime(a);
                JiffDateTime y = JiffOracleSupport.toDateTime(b);
                result = until ? x.until(y, options) : x.since(y, options);
            } else if (kind.equals('TS')) {
                JiffTimestamp x = JiffOracleSupport.toTimestamp(a);
                JiffTimestamp y = JiffOracleSupport.toTimestamp(b);
                result = until ? x.until(y, options) : x.since(y, options);
            } else {
                JiffTimeZone tz = zone(kind.substring(2));
                JiffZonedDateTime x = JiffOracleSupport.toTimestamp(a).toZonedDateTime(tz);
                JiffZonedDateTime y = JiffOracleSupport.toTimestamp(b).toZonedDateTime(tz);
                result = until ? x.until(y, options) : x.since(y, options);
            }
            return JiffOracleSupport.spanText(result);
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void roundedDifferencesAgreeWithJiff() {
        List<String> rows = JiffOracleDifferenceRoundData.rows();
        Assert.isTrue(rows.size() >= 480, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffDifference options = new JiffDifference()
                .largest(optionalUnit(f.get(3)))
                .smallest(optionalUnit(f.get(4)))
                .increment(Long.valueOf(f.get(5)))
                .mode(JiffOracleSupport.mode(f.get(6)));
            Assert.areEqual(
                f.get(7),
                difference(true, f.get(0), f.get(1), f.get(2), options),
                'until of ' + row
            );
            Assert.areEqual(
                f.get(8),
                difference(false, f.get(0), f.get(1), f.get(2), options),
                'since of ' + row
            );
        }
    }
}
