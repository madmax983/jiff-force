/**
 * Replays zoned datetime vectors generated by the real Jiff crate (see `oracle/`) against the
 * port. The inputs crowd around changes of offset, where days are 23 or 25 hours long and clock
 * readings are skipped or repeated. Every value is an instant in a named zone, so nothing here
 * relies on the port's own printing or parsing.
 */
@IsTest
private class JiffOracleZonedTest {
    private static final List<JiffUnit> LARGEST_UNITS = new List<JiffUnit>{
        JiffUnit.YEAR,
        JiffUnit.MONTH,
        JiffUnit.WEEK,
        JiffUnit.DAY,
        JiffUnit.HOUR,
        JiffUnit.NANOSECOND
    };

    private static final Map<String, JiffTimeZone> ZONES = new Map<String, JiffTimeZone>();

    private static JiffZonedDateTime zoned(String zone, String instant) {
        if (!ZONES.containsKey(zone)) {
            ZONES.put(zone, JiffTimeZone.get(zone));
        }
        return JiffOracleSupport.toTimestamp(instant).toZonedDateTime(ZONES.get(zone));
    }

    private static String instantOf(JiffZonedDateTime value) {
        return JiffOracleSupport.timestampText(value.toTimestamp());
    }

    private static String arithmetic(Boolean adding, JiffZonedDateTime zdt, JiffSpan span) {
        try {
            return instantOf(adding ? zdt.add(span) : zdt.subtract(span));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void spanArithmeticAgreesWithJiff() {
        List<String> rows = JiffOracleZonedSpanData.rows();
        Assert.isTrue(rows.size() >= 600, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffZonedDateTime zdt = zoned(f.get(0), f.get(1));
            JiffSpan span = JiffOracleSupport.toSpan(f.get(2));
            Assert.areEqual(f.get(3), arithmetic(true, zdt, span), 'adding in ' + row);
            Assert.areEqual(f.get(4), arithmetic(false, zdt, span), 'subtracting in ' + row);
        }
    }

    private static String until(JiffZonedDateTime a, JiffZonedDateTime b, JiffUnit largest) {
        try {
            return JiffOracleSupport.spanText(a.until(b, largest));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void differencesAgreeWithJiff() {
        List<String> rows = JiffOracleZonedDifferenceData.rows();
        Assert.isTrue(rows.size() >= 450, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffZonedDateTime a = zoned(f.get(0), f.get(1));
            JiffZonedDateTime b = zoned(f.get(0), f.get(2));
            for (Integer i = 0; i < LARGEST_UNITS.size(); i++) {
                JiffUnit unit = LARGEST_UNITS.get(i);
                Assert.areEqual(f.get(3 + i), until(a, b, unit), 'until in ' + unit + ' of ' + row);
            }
            Assert.areEqual(
                f.get(9),
                JiffOracleSupport.durationText(a.durationUntil(b)),
                'duration until of ' + row
            );
        }
    }

    private static void replayRounding(Integer first, Integer last) {
        List<String> rows = JiffOracleZonedRoundData.rows();
        Assert.isTrue(rows.size() >= 600, 'expected the full vector set');
        for (Integer i = first; i < Math.min(last, rows.size()); i++) {
            String row = rows.get(i);
            List<String> f = JiffOracleSupport.fields(row);
            JiffZonedDateTime zdt = zoned(f.get(0), f.get(1));
            JiffRound options = JiffRound.to(JiffOracleSupport.unit(f.get(2)))
                .increment(Long.valueOf(f.get(3)))
                .mode(JiffOracleSupport.mode(f.get(4)));
            String actual;
            try {
                actual = instantOf(zdt.round(options));
            } catch (JiffException e) {
                actual = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(5), actual, 'rounding of ' + row);
        }
    }

    @IsTest
    static void roundingToDaysOfEveryLengthAgreesWithJiff() {
        replayRounding(0, 432);
    }

    @IsTest
    static void roundingToSmallerUnitsAgreesWithJiff() {
        replayRounding(432, 10000);
    }

    private static String attempt(String op, JiffZonedDateTime zdt) {
        try {
            if (op.equals('startOfDay')) {
                return instantOf(zdt.startOfDay());
            } else if (op.equals('endOfDay')) {
                return instantOf(zdt.endOfDay());
            } else if (op.equals('tomorrow')) {
                return instantOf(zdt.tomorrow());
            } else if (op.equals('yesterday')) {
                return instantOf(zdt.yesterday());
            } else if (op.equals('firstOfMonth')) {
                return instantOf(zdt.firstOfMonth());
            }
            return instantOf(zdt.lastOfMonth());
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void calendarHelpersAgreeWithJiff() {
        List<String> operations = new List<String>{
            'startOfDay',
            'endOfDay',
            'tomorrow',
            'yesterday',
            'firstOfMonth',
            'lastOfMonth'
        };
        List<String> rows = JiffOracleZonedCalendarData.rows();
        Assert.isTrue(rows.size() >= 450, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            JiffZonedDateTime zdt = zoned(f.get(0), f.get(1));
            for (Integer i = 0; i < operations.size(); i++) {
                Assert.areEqual(
                    f.get(2 + i),
                    attempt(operations.get(i), zdt),
                    operations.get(i) + ' of ' + row
                );
            }
        }
    }
}
