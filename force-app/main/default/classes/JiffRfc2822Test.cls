                },
                new List<String>{
                    'Wed, 10 Jan 2024 05:34:45 -0500 (wa(t)',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: found opening parenthesis in comment with no matching closing parenthesis'
                },
                new List<String>{
                    'Wed, 10 Jan 2024 05:34:45 -0500 (w',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: found opening parenthesis in comment with no matching closing parenthesis'
                },
                new List<String>{
                    'Wed, 10 Jan 2024 05:34:45 -0500 (',
