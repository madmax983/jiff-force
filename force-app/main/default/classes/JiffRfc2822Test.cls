                    '2024-07-13T15:09:59-04:00[-04:00]'
                },
                new List<String>{
                    'Thu, 10 Jan 2024 05:34:45 -0500',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: found parsed weekday of `Thursday`, but parsed datetime has weekday `Wednesday`'
                },
                new List<String>{
                    'Wed, 29 Feb 2023 05:34:45 -0500',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: invalid date: parameter \'day\' for `2023-02` is invalid, must be in range `1..=28`'
                },
                new List<String>{
                    'Mon, 31 Jun 2024 05:34:45 -0500',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: invalid date: parameter \'day\' for `2024-06` is invalid, must be in range `1..=30`'
                },
                new List<String>{
                    'Tue, 32 Jun 2024 05:34:45 -0500',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: failed to parse day: parameter \'day\' is not in the required range of 1..=31'
                },
                new List<String>{
                    'Sun, 30 Jun 2024 24:00:00 -0500',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: failed to parse hour (expects a two digit integer): parameter \'hour\' is not in the required range of 0..=23'
                },
                new List<String>{
                    'Wed, 10 Jan 2024 05:34MST',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: expected whitespace after parsing time: expected at least one whitespace character (space or tab), but found none'
                },
                new List<String>{
                    '',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: expected RFC 2822 datetime, but got empty string'
                },
                new List<String>{
                    ' ',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: expected RFC 2822 datetime, but got empty string after trimming leading whitespace'
                },
                new List<String>{
                    'Wat',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: expected day at beginning of RFC 2822 datetime since first non-whitespace byte, `W`, is not a digit, but given string is too short (length is 3)'
                },
                new List<String>{
                    'Wed',
