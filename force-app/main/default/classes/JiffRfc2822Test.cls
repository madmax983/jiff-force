/**
 * RFC 2822 parsing and printing, and RFC 9110 printing.
 *
 * Every expected text, or `ERR:` and the error message, is what Jiff 1.0.0 itself produced
 * for the same input: the tables were generated by running the real crate
 * (`fmt::rfc2822::parse`, `DateTimeParser` with and without `relaxed_weekday`, and
 * `DateTimePrinter`). They include every case of the snapshot tests in Jiff's
 * `fmt::rfc2822` module. Nothing here was computed by the port.
 *
 * Zoned datetimes to print are given as `civil datetime|zone`, where the zone is an IANA name
 * or `@` and a fixed offset in seconds.
 */
@IsTest
private class JiffRfc2822Test {
    private static String attempt(String input, String kind) {
        try {
            if (kind.equals('zoned')) {
                return JiffRfc2822.parse(input).toString();
            }
            if (kind.equals('timestamp')) {
                return JiffRfc2822.parseTimestamp(input).toString();
            }
            if (kind.equals('relaxed zoned')) {
                return JiffRfc2822.parse(input, true).toString();
            }
            return JiffRfc2822.parseTimestamp(input, true).toString();
        } catch (JiffException e) {
            return 'ERR:' + e.getMessage();
        }
    }

    private static void check(List<String> failures, String what, String expected, String actual) {
        if (!expected.equals(actual)) {
            failures.add(what + ': expected [' + expected + '] got [' + actual + ']');
        }
    }

    private static void assertParsesZoned(List<List<String>> rows) {
        List<String> failures = new List<String>();
        for (List<String> row : rows) {
            check(failures, '<' + row[0] + '>', row[1], attempt(row[0], 'zoned'));
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

    private static void assertParsesTimestamps(List<List<String>> rows) {
        List<String> failures = new List<String>();
        for (List<String> row : rows) {
            check(failures, '<' + row[0] + '>', row[1], attempt(row[0], 'timestamp'));
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

    // Each input appears twice: parsed as a zoned datetime, then as a timestamp.
    private static void assertParsesRelaxed(List<List<String>> rows) {
        List<String> failures = new List<String>();
        for (Integer i = 0; i < rows.size(); i += 2) {
            check(
                failures,
                '<' + rows[i][0] + '>',
                rows[i][1],
                attempt(rows[i][0], 'relaxed zoned')
            );
            check(
                failures,
                '<' + rows[i + 1][0] + '>',
                rows[i + 1][1],
                attempt(rows[i + 1][0], 'relaxed timestamp')
            );
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

    private static JiffZonedDateTime zonedOf(String spec) {
        Integer bar = spec.indexOf('|');
        JiffDateTime dt = JiffDateTime.parse(spec.substring(0, bar));
        String zone = spec.substring(bar + 1);
        JiffTimeZone tz = zone.startsWith('@')
            ? JiffTimeZone.fixed(JiffOffset.fromSeconds(Integer.valueOf(zone.substring(1))))
            : JiffTimeZone.get(zone);
        return tz.toZonedDateTime(dt);
    }

    private static void assertPrintsZoned(List<List<String>> rows) {
        List<String> failures = new List<String>();
        for (List<String> row : rows) {
            String actual;
            try {
                actual = JiffRfc2822.toString(zonedOf(row[0]));
            } catch (JiffException e) {
                actual = 'ERR:' + e.getMessage();
            }
            check(failures, row[0], row[1], actual);
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

    private static void assertPrintsTimestamps(List<List<String>> rows) {
        List<String> failures = new List<String>();
        for (List<String> row : rows) {
            JiffTimestamp ts = JiffTimestamp.parse(row[0]);
            String rfc2822;
            String rfc9110;
            try {
                rfc2822 = JiffRfc2822.timestampToString(ts);
            } catch (JiffException e) {
                rfc2822 = 'ERR:' + e.getMessage();
            }
            try {
                rfc9110 = JiffRfc2822.timestampToRfc9110String(ts);
            } catch (JiffException e) {
                rfc9110 = 'ERR:' + e.getMessage();
            }
            check(failures, row[0] + ' (RFC 2822)', row[1], rfc2822);
            check(failures, row[0] + ' (RFC 9110)', row[2], rfc9110);
        }
        Assert.areEqual(0, failures.size(), String.join(failures, '\n'));
    }

