                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: found opening parenthesis in comment with no matching closing parenthesis'
                },
                new List<String>{
                    'Wed, 10 Jan 2024 05:34:45 -0500 x',
                    'ERR:parsed value \'2024-01-10T05:34:45-05:00[-05:00]\', but unparsed input "x" remains (expected no unparsed input)'
                },
                new List<String>{
                    'Wed, 10 Jan 2024 05:34:45 -0500 (a) b',
                    'ERR:parsed value \'2024-01-10T05:34:45-05:00[-05:00]\', but unparsed input "b" remains (expected no unparsed input)'
                },
                new List<String>{
                    'Wed, 10 Jan 24 05:34:45 -0500',
                    '2024-01-10T05:34:45-05:00[-05:00]'
                },
                new List<String>{
                    'Wed, 10 Jan 49 05:34:45 -0500',
                    'ERR:failed to parse RFC 2822 datetime into Jiff zoned datetime: found parsed weekday of `Wednesday`, but parsed datetime has weekday `Sunday`'
                }
            }
        );
    }

