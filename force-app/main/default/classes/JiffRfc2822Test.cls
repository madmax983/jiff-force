    @IsTest
    static void zonedDatetimeRoundTripsWithoutItsZoneAndFraction() {
        JiffZonedDateTime zdt = JiffDate.newInstance(2024, 7, 13)
            .at(15, 9, 59, 789000000)
            .inTz('America/New_York');
        Assert.areEqual('2024-07-13T15:09:59.789-04:00[America/New_York]', zdt.toString());
        String text = JiffRfc2822.toString(zdt);
        Assert.areEqual('Sat, 13 Jul 2024 15:09:59 -0400', text);
        Assert.areEqual('2024-07-13T15:09:59-04:00[-04:00]', JiffRfc2822.parse(text).toString());
    }

    @IsTest
    static void extremeOffsetsRoundTripToTheNearestSupportedMinute() {
        JiffDateTime dt = JiffDateTime.newInstance(2025, 12, 25, 17, 0, 0, 0);
        String text = JiffRfc2822.toString(JiffTimeZone.fixed(JiffOffset.MIN).toZonedDateTime(dt));
        Assert.areEqual('Thu, 25 Dec 2025 17:00:00 -2559', text);
        Assert.areEqual(
            JiffTimeZone.fixed(JiffOffset.fromSeconds(-(25 * 3600 + 59 * 60))).toZonedDateTime(dt),
            JiffRfc2822.parse(text)
        );
        text = JiffRfc2822.toString(JiffTimeZone.fixed(JiffOffset.MAX).toZonedDateTime(dt));
        Assert.areEqual('Thu, 25 Dec 2025 17:00:00 +2559', text);
        Assert.areEqual(
            JiffTimeZone.fixed(JiffOffset.fromSeconds(25 * 3600 + 59 * 60)).toZonedDateTime(dt),
            JiffRfc2822.parse(text)
        );
    }

    @IsTest
    static void deeplyNestedCommentsAreRejected() {
        String input = 'Wed, 10 Jan 2024 05:34:45 -0500 ' + '('.repeat(256) + ')'.repeat(256);
        try {
            JiffRfc2822.parse(input);
            Assert.fail('expected 256 nested parentheses to be rejected');
        } catch (JiffException e) {
            Assert.areEqual(
                'failed to parse RFC 2822 datetime into Jiff zoned datetime: found too many nested parenthesis in comment',
                e.getMessage()
            );
        }
        String nested = 'Wed, 10 Jan 2024 05:34:45 -0500 ' + '('.repeat(255) + ')'.repeat(255);
        Assert.areEqual('2024-01-10T05:34:45-05:00[-05:00]', JiffRfc2822.parse(nested).toString());
    }

    @IsTest
    static void nullArgumentsAreRejected() {
        List<String> messages = new List<String>();
        try {
            JiffRfc2822.parse(null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        try {
            JiffRfc2822.parse('Wed, 10 Jan 2024 05:34:45 -0500', null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        try {
            JiffRfc2822.parseTimestamp('Wed, 10 Jan 2024 05:34:45 -0500', null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        try {
            JiffRfc2822.parseTimestamp(null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        try {
            JiffRfc2822.toString(null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        try {
            JiffRfc2822.timestampToString(null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        try {
            JiffRfc2822.timestampToRfc9110String(null);
        } catch (JiffException e) {
            messages.add(e.getMessage());
        }
        Assert.areEqual(7, messages.size(), String.join(messages, '\n'));
    }
