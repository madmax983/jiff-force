    @IsTest
    static void zonedDatetimesParseLikeJiff2() {
        assertParsesZoned(
            new List<List<String>>{
                new List<String>{
                    'Wed, 10 Jan 2024 05 :  34 :   45 -0500',
                    '2024-01-10T05:34:45-05:00[-05:00]'
                },
                new List<String>{
                    '  wed, 10 jAN 2024 05:34:45 -0500',
                    '2024-01-10T05:34:45-05:00[-05:00]'
