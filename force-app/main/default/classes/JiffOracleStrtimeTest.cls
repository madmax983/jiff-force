/**
 * Replays strftime, strptime and RFC 2822 / RFC 9110 vectors generated by the real Jiff crate
 * (see `oracle/`) against the port.
 *
 * A value is written `D:<date>`, `T:<time>`, `DT:<datetime>`, `TS:<secs,nanos>` or
 * `Z:<zone>:<secs,nanos>`, and is built here with plain constructors, never by parsing.
 */
@IsTest
private class JiffOracleStrtimeTest {
    private static final Map<String, JiffTimeZone> ZONES = new Map<String, JiffTimeZone>();

    private static JiffTimeZone zone(String name) {
        if (!ZONES.containsKey(name)) {
            ZONES.put(name, JiffTimeZone.get(name));
        }
        return ZONES.get(name);
    }

    private static JiffZonedDateTime zoned(String text) {
        // Z:<zone>:<secs,nanos>; zone names contain no colon.
        Integer instantAt = text.indexOf(':', 2);
        return JiffOracleSupport.toTimestamp(text.substring(instantAt + 1))
            .toZonedDateTime(zone(text.substring(2, instantAt)));
    }

    private static String zonedText(JiffZonedDateTime value) {
        return 'Z:' +
            value.timeZone().ianaName() +
            ':' +
            JiffOracleSupport.timestampText(value.toTimestamp());
    }

    /** Jiff's strict `strtime::format`, which rejects an unknown directive instead of printing it. */
    private static String strftime(String value, String format) {
        try {
            if (value.startsWith('DT:')) {
                return JiffStrtime.format(format, JiffOracleSupport.toDateTime(value.substring(3)));
            } else if (value.startsWith('D:')) {
                return JiffStrtime.format(format, JiffOracleSupport.toDate(value.substring(2)));
            } else if (value.startsWith('TS:')) {
                return JiffStrtime.format(
                    format,
                    JiffOracleSupport.toTimestamp(value.substring(3))
                );
            } else if (value.startsWith('T:')) {
                return JiffStrtime.format(format, JiffOracleSupport.toTime(value.substring(2)));
            }
            return JiffStrtime.format(format, zoned(value));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void formattingAgreesWithJiff() {
        List<String> rows = JiffOracleStrtimeFormatData.rows();
        Assert.isTrue(rows.size() >= 500, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            Assert.areEqual(f.get(2), strftime(f.get(0), f.get(1)), 'formatting ' + row);
        }
    }

    private static String strptime(String kind, String format, String input) {
        try {
            if (kind.equals('D')) {
                return 'D:' + JiffDate.strptime(format, input).toString();
            } else if (kind.equals('T')) {
                return 'T:' + JiffTime.strptime(format, input).toString();
            } else if (kind.equals('DT')) {
                return 'DT:' + JiffDateTime.strptime(format, input).toString();
            } else if (kind.equals('TS')) {
                return 'TS:' +
                    JiffOracleSupport.timestampText(JiffTimestamp.strptime(format, input));
            }
            return zonedText(JiffZonedDateTime.strptime(format, input));
        } catch (JiffException e) {
            return JiffOracleSupport.ERR;
        }
    }

    @IsTest
    static void parsingAgreesWithJiff() {
        List<String> rows = JiffOracleStrtimeParseData.rows();
        Assert.isTrue(rows.size() >= 400, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            Assert.areEqual(
                f.get(3),
                strptime(f.get(2), f.get(0), JiffOracleSupport.toInput(f.get(1))),
                'parsing ' + row
            );
        }
    }

    @IsTest
    static void rfc2822ParsingAgreesWithJiff() {
        List<String> rows = JiffOracleRfc2822ParseData.rows();
        Assert.isTrue(rows.size() >= 150, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            String input = JiffOracleSupport.toInput(f.get(0));
            String offset;
            String instant;
            try {
                JiffZonedDateTime parsed = JiffRfc2822.parse(input);
                offset = String.valueOf(parsed.offset().seconds());
                instant = JiffOracleSupport.timestampText(parsed.toTimestamp());
            } catch (JiffException e) {
                offset = JiffOracleSupport.ERR;
                instant = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(1), offset, 'offset of ' + row);
            Assert.areEqual(f.get(2), instant, 'instant of ' + row);
            String timestamp;
            try {
                timestamp = JiffOracleSupport.timestampText(JiffRfc2822.parseTimestamp(input));
            } catch (JiffException e) {
                timestamp = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(3), timestamp, 'timestamp of ' + row);
        }
    }

    @IsTest
    static void rfc2822PrintingAgreesWithJiff() {
        List<String> rows = JiffOracleRfc2822PrintData.rows();
        Assert.isTrue(rows.size() >= 150, 'expected the full vector set');
        for (String row : rows) {
            List<String> f = JiffOracleSupport.fields(row);
            String printed;
            String rfc9110 = '-';
            try {
                if (f.get(0).startsWith('TS:')) {
                    JiffTimestamp ts = JiffOracleSupport.toTimestamp(f.get(0).substring(3));
                    printed = JiffRfc2822.timestampToString(ts);
                    rfc9110 = JiffRfc2822.timestampToRfc9110String(ts);
                } else {
                    printed = JiffRfc2822.toString(zoned(f.get(0)));
                }
            } catch (JiffException e) {
                printed = JiffOracleSupport.ERR;
            }
            Assert.areEqual(f.get(1), printed, 'RFC 2822 of ' + row);
            Assert.areEqual(f.get(2), rfc9110, 'RFC 9110 of ' + row);
        }
    }
}
